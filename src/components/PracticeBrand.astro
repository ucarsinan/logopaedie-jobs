---
import practiceLogo from '../assets/brand/praxis-simsek-horizontal.svg?raw';
import '../styles/fonts.css';

interface Props { class?: string; dark?: boolean; }
const { class: className, dark = false } = Astro.props;

// Bei mehreren Logos pro Seite braucht jede SVG eigene Beschriftungs-IDs.
const id = `praxis-${crypto.randomUUID()}`;
const logo = practiceLogo
  .replace('<svg ', '<svg width="256" height="79" ')
  .replace('aria-labelledby="title desc"', `aria-labelledby="${id}-title ${id}-desc"`)
  .replace('id="title"', `id="${id}-title"`)
  .replace('id="desc"', `id="${id}-desc"`);
---
<span class:list={['praxis-marke', { dunkel: dark }, className]} set:html={logo} />

<style>
  .praxis-marke {
    display: block;
    width: 16rem;
    max-width: 100%;
    min-width: 0;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
  }
  .praxis-marke :global(svg) { display: block; max-width: 100%; height: auto; }
  .dunkel { background: white; }
</style>
