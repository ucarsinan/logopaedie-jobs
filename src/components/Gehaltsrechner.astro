---
const fields = [
  { name: 'stundenlohn', label: 'Bruttostundenlohn (€)', value: 23, min: 0.01 },
  { name: 'wochenstunden', label: 'Vertragliche Wochenstunden', value: 38.5, min: 0.01 },
  { name: 'sonderzahlungJahr', label: 'Vereinbarte Brutto-Sonderzahlungen pro Jahr (€)', value: 0, min: 0 },
  { name: 'arbeitgeberbeitragJahr', label: 'Zusätzlicher Arbeitgeberbeitrag für Leistungen pro Jahr (€)', value: 0, min: 0 },
];
---

<div class="p-px rounded-3xl bg-simsek-green shadow-sm">
  <div class="bg-white rounded-[calc(1.5rem-1px)] p-6 md:p-10" id="gehaltsrechner">
    <p class="text-sm text-slate-600 mb-6">Trage deinen angebotenen oder vereinbarten Stundenlohn und deine Wochenstunden ein. Die vorausgefüllten Werte sind ein Rechenbeispiel. Wenn keine zusätzlichen Zahlungen vereinbart sind, lass die Jahresbeträge bei 0.</p>
    <form id="rechner-form" class="grid gap-5 md:grid-cols-2" aria-describedby="rechner-hinweis">
      {fields.map((field) => (
        <div class="flex flex-col gap-1.5">
          <label for={field.name} class="text-xs font-bold uppercase tracking-wider text-slate-500">{field.label}</label>
          <input id={field.name} name={field.name} type="number" inputmode="decimal" min={field.min} step="0.01" value={field.value} required aria-describedby={field.name === 'arbeitgeberbeitragJahr' ? 'beitrag-hinweis' : undefined} class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-slate-900 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-simsek-blue focus:bg-white" />
          {field.name === 'arbeitgeberbeitragJahr' && <p id="beitrag-hinweis" class="text-xs text-slate-500">Nur den bestätigten, zusätzlich finanzierten Arbeitgeberanteil eintragen. Eigenanteile und Entgeltumwandlung nicht einrechnen. Dieser Betrag wird separat gezeigt und nicht zum Bruttogehalt addiert.</p>}
        </div>
      ))}
    </form>
    <div id="rechner-ergebnis" aria-live="polite" aria-atomic="true" class="mt-10 pt-8 border-t border-slate-200">
      <p data-out="fehler" class="text-sm text-slate-700 mb-4"></p>
      <dl class="grid gap-6 md:grid-cols-2">
        <div class="p-5 bg-slate-50 rounded-2xl">
          <dt class="text-xs uppercase tracking-widest text-slate-500 font-bold mb-2">Monatsbrutto im Jahresmittel</dt>
          <dd><span class="text-2xl font-bold text-slate-900" data-out="monat">—</span><p class="text-xs text-slate-500 mt-1">Ohne Sonderzahlungen, mit 52 Wochen / 12 Monaten</p></dd>
        </div>
        <div class="p-5 bg-slate-50 rounded-2xl">
          <dt class="text-xs uppercase tracking-widest text-slate-500 font-bold mb-2">Jahresbrutto ohne Sonderzahlungen</dt>
          <dd class="text-2xl font-bold text-slate-900" data-out="jahr">—</dd>
        </div>
        <div class="p-5 border border-simsek-green rounded-2xl">
          <dt class="text-xs uppercase tracking-widest text-simsek-blue font-bold mb-2">Jahresbrutto mit Sonderzahlungen</dt>
          <dd class="text-2xl font-bold text-simsek-blue" data-out="jahr-gesamt">—</dd>
        </div>
        <div class="p-5 border border-slate-200 rounded-2xl">
          <dt class="text-xs uppercase tracking-widest text-slate-500 font-bold mb-2">Zusätzlicher Arbeitgeberbeitrag / Jahr</dt>
          <dd><span class="text-2xl font-bold text-slate-900" data-out="beitrag">—</span><p class="text-xs text-slate-500 mt-1">Separat; kein Brutto- oder Nettolohnäquivalent</p></dd>
        </div>
      </dl>
    </div>
    <p id="rechner-hinweis" class="text-xs text-slate-500 mt-6">Formel: Stundenlohn × Wochenstunden × 52 / 12. Das tatsächliche Monatsentgelt richtet sich nach der vertraglichen Abrechnung. Vier Arbeitstage bestimmen nicht automatisch die Wochenstunden. Keine Netto-, Marktgehalts- oder Tarifberechnung.</p>
    <noscript><p class="text-sm text-slate-600 mt-4">Für die interaktive Berechnung bitte JavaScript aktivieren. Du kannst die oben angegebene Formel auch selbst verwenden.</p></noscript>
  </div>
</div>

<script>
  import { berechneGehalt } from '../lib/gehalt-daten';
  const form = document.getElementById('rechner-form') as HTMLFormElement | null;
  const euro = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' });
  function setOut(key: string, value: string) {
    const element = document.querySelector(`[data-out="${key}"]`);
    if (element) element.textContent = value;
  }
  function update() {
    if (!form) return;
    try {
      if (!form.checkValidity()) throw new RangeError('Bitte alle Felder mit gültigen Zahlen ausfüllen: Lohn und Stunden größer als 0, Jahresbeträge mindestens 0.');
      const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).valueAsNumber;
      const result = berechneGehalt({
        stundenlohn: value('stundenlohn'), wochenstunden: value('wochenstunden'),
        sonderzahlungJahr: value('sonderzahlungJahr'), arbeitgeberbeitragJahr: value('arbeitgeberbeitragJahr'),
      });
      setOut('monat', euro.format(result.bruttoMonat));
      setOut('jahr', euro.format(result.bruttoJahr));
      setOut('jahr-gesamt', euro.format(result.bruttoJahrMitSonderzahlung));
      setOut('beitrag', euro.format(result.arbeitgeberbeitragJahr));
      setOut('fehler', '');
    } catch (error) {
      for (const key of ['monat', 'jahr', 'jahr-gesamt', 'beitrag']) setOut(key, '—');
      setOut('fehler', error instanceof Error ? error.message : 'Bitte Eingaben prüfen.');
    }
  }
  form?.addEventListener('submit', (event) => event.preventDefault());
  form?.addEventListener('input', update);
  update();
</script>
