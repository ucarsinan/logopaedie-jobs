---
import PracticeBrand from './PracticeBrand.astro';
import { Image } from 'astro:assets';
import therapieraum from '../assets/praxis-bild-3.jpg';
---
<section id="ueber-uns" aria-labelledby="praxis-vorstellung" class="praxis-auftakt">
  <header>
    <PracticeBrand class="praxis-signatur" />
    <h1 id="praxis-vorstellung">Praxis für Logopädie Şimşek <span>in Duisburg</span></h1>
    <p class="vorspann">Wir sind Mara, Şeyma, Kristina und Emel. Bei uns entscheidest du mit, wie wir den Praxisalltag gestalten.</p>
  </header>
  <slot />
  <div class="praxis-aufmacher">
    <figure class="praxis-titelbild">
      <Image src={therapieraum} alt="Der Therapietisch am Fenster, daneben Holzspielzeug und Bildmaterial." widths={[420, 720, 1080, 1440]} sizes="(min-width: 961px) 42vw, (min-width: 768px) 52vw, 100vw" loading="eager" fetchpriority="high" />
      <figcaption>Am Therapietisch in Duisburg-Mitte</figcaption>
    </figure>
    <figure class="praxis-zitat">
      <blockquote>„Wir möchten, dass gute Therapie und ein gutes Arbeitsleben zusammenpassen – fachlich klar, menschlich nah und mitten in Duisburg.“</blockquote>
      <figcaption><strong>Emel Şimşek-Uçar</strong><span>Staatlich anerkannte Logopädin und Praxisinhaberin</span></figcaption>
    </figure>
  </div>
</section>
