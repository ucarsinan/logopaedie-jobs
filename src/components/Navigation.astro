---
import Logo from './Logo.astro';

const { pathname } = Astro.url;
const isContact = pathname.replace(/\/$/, '') === '/kontakt';
const pageLinks = [
  { href: '/jobs/logopaedin-sprachtherapeut-duisburg/', label: 'Team & Stelle', active: pathname.startsWith('/jobs') },
  { href: '/berufshandbuch/', label: 'Berufshandbuch', active: pathname.startsWith('/berufshandbuch') },
  { href: '/gehaltsrechner/', label: 'Gehaltsrechner', active: pathname.startsWith('/gehaltsrechner') },
];
---

<nav aria-label="Hauptnavigation" class="sticky top-0 z-50 border-b border-slate-100/80 bg-white/95 backdrop-blur-md">
  <div class="absolute top-0 left-0 right-0 h-0.5 bg-simsek-green" aria-hidden="true"></div>
  <div class="mx-auto flex h-[68px] max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" aria-label="Zur Startseite" class="shrink-0 rounded-lg transition-opacity hover:opacity-85 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-simsek-green focus-visible:ring-offset-4">
      <Logo class="h-10 w-auto md:h-11" />
    </a>
    <div class="ml-auto flex items-center gap-2 sm:gap-4 lg:gap-8">
      <div class="hidden items-center gap-7 lg:flex">
        {pageLinks.map(link => (
          <a href={link.href} aria-current={link.active ? 'page' : undefined} class={[
            'inline-flex min-h-11 items-center border-b-2 px-0.5 py-2 text-[15px] font-medium no-underline transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-simsek-green',
            link.active ? 'border-simsek-green text-slate-900' : 'border-transparent text-slate-600 hover:border-slate-300 hover:text-slate-900',
          ].join(' ')}>{link.label}</a>
        ))}
      </div>
      <a href="/kontakt/" aria-current={isContact ? 'page' : undefined} class="inline-flex min-h-11 items-center justify-center rounded-lg bg-simsek-green px-5 py-2.5 text-sm font-bold text-white no-underline transition-colors hover:bg-simsek-green/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-simsek-green focus-visible:ring-offset-4 sm:text-[15px]">Kontakt</a>
      <button id="mobile-menu-btn" type="button" aria-label="Menü öffnen" aria-controls="mobile-menu" aria-expanded="false" class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg text-slate-600 transition-colors hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-simsek-green lg:hidden">
        <svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path stroke-linecap="round" d="m6 6 12 12M6 18 18 6" /></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white lg:hidden">
    <div class="mx-auto max-w-7xl divide-y divide-slate-100 px-6 py-2">
      {pageLinks.map(link => (
        <a href={link.href} aria-current={link.active ? 'page' : undefined} class={[
          'mobile-nav-link flex min-h-11 items-center px-1 py-4 text-base font-medium no-underline transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-simsek-green',
          link.active ? 'text-simsek-green' : 'text-slate-700 hover:text-simsek-green',
        ].join(' ')}>{link.label}</a>
      ))}
    </div>
  </div>
</nav>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  const setMenuState = (isOpen) => {
    if (!btn || !menu || !iconOpen || !iconClose) return;
    menu.classList.toggle('hidden', !isOpen);
    iconOpen.classList.toggle('hidden', isOpen);
    iconClose.classList.toggle('hidden', !isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
    btn.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen');
  };

  btn?.addEventListener('click', () => {
    setMenuState(menu?.classList.contains('hidden') ?? false);
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      setMenuState(false);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      setMenuState(false);
      btn?.focus();
    }
  });
</script>
