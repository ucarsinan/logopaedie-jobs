---
import RecruitingWhatsAppLink from './RecruitingWhatsAppLink.astro';
---

<nav
  aria-label="Schnellkontakt"
  class="fixed inset-x-0 bottom-0 z-40 flex items-center gap-2 border-t border-slate-200 bg-white/95 px-3 py-2 shadow-[0_-4px_16px_rgba(15,23,42,0.08)] backdrop-blur md:hidden"
>
  <RecruitingWhatsAppLink class="min-w-0 flex-1 px-2.5" />
  <a
    href="/kontakt/"
    class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg border-2 border-slate-200 px-3 py-2.5 text-sm font-bold text-slate-800 no-underline transition-colors duration-200 hover:border-simsek-green focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-950"
  >
    Kontakt
  </a>
</nav>
