---
import RecruitingWhatsAppLink from './RecruitingWhatsAppLink.astro';

const applicationHref = '/jobs/logopaedin-sprachtherapeut-duisburg/#bewerbung';
---
<section id="apply" class="py-8 md:py-14 bg-slate-900 text-white rounded-3xl md:rounded-3xl mx-4 md:mx-6 my-6 md:my-10 overflow-hidden relative">
  <div class="max-w-3xl mx-auto px-6 relative z-10 text-center">
    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-simsek-green/20 text-simsek-green border border-simsek-green/30 mb-3">
      Bewerben
    </span>
    <h2 class="text-2xl md:text-3xl font-semibold mb-3 leading-tight">Erst kennenlernen, dann bewerben</h2>
    <div class="h-px bg-simsek-green mb-3"></div>
    <p class="text-slate-300 mb-6">Für den Erstkontakt genügen dein Name und eine Rückkontaktmöglichkeit – ein Lebenslauf ist nicht erforderlich.</p>
    <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={applicationHref}
        class="inline-flex min-h-11 w-full items-center justify-center px-6 py-3 bg-simsek-green text-white text-sm font-bold rounded-lg shadow-md hover:shadow-lg transition-all duration-200 no-underline sm:w-auto"
      >
        Unverbindlich Kontakt aufnehmen
      </a>
      <RecruitingWhatsAppLink
        label="WhatsApp für Bewerbungen"
        class="w-full sm:w-auto"
      />
    </div>
  </div>
</section>
