---
import { CONTACT_PATTERN_SOURCE, CONTACT_INTENTS } from '../lib/application-form.mjs';
import ContactAlternatives from './ContactAlternatives.astro';

interface Props { standalone?: boolean; }
const { standalone = false } = Astro.props;
---

<section id="bewerbung" data-standalone={standalone || undefined} class="scroll-mt-24 bg-slate-900 text-white py-14 md:py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(300px,0.9fr)] lg:gap-x-12 lg:gap-y-8">
      {standalone ? (
        <header>
          <a href="/jobs/logopaedin-sprachtherapeut-duisburg/" class="mb-3 inline-flex min-h-11 items-center gap-2 text-sm text-slate-300 underline underline-offset-4"><span aria-hidden="true">←</span> Zurück zur Stelle</a>
          <h1 class="text-3xl font-semibold leading-tight sm:text-4xl">Lass uns kennenlernen.</h1>
          <p class="mt-3 text-slate-300">Unverbindlich und ohne Anschreiben.</p>
        </header>
      ) : (
      <div class="lg:col-start-1 lg:row-start-1">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-simsek-green/20 text-simsek-green border border-simsek-green/30 mb-4">
          Unverbindlicher Erstkontakt
        </span>
        <h2 class="text-3xl md:text-5xl font-semibold leading-tight mb-4">Lass uns einander kennenlernen.</h2>
        <p class="text-slate-300 leading-relaxed max-w-xl">
          Du möchtest wissen, ob unser Team zu dir passt? Schreib uns. Im ersten Gespräch lernen wir einander kennen und sprechen über deine Wünsche und unsere Zusammenarbeit. Ein Anschreiben ist nicht nötig, ein Lebenslauf freiwillig.
        </p>
        <p
          data-response-promise
          class="mt-5 flex max-w-xl items-start gap-3 rounded-xl border border-simsek-green/30 bg-simsek-green/10 px-4 py-3 text-sm leading-relaxed text-white"
        >
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-simsek-green" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l2.5 2.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          <span><strong class="font-bold">Wir melden uns innerhalb von 12 Stunden</strong> &ndash; auch am Wochenende. Anfragen zwischen 20 und 8 Uhr beantworten wir am Morgen.</span>
        </p>
      </div>

      )}

      {!standalone && <ContactAlternatives />}

      <div class="order-3 rounded-3xl bg-white p-5 text-slate-900 shadow-xl sm:p-7 lg:col-start-2 lg:row-start-1 lg:row-span-2">
        <div
          id="bewerbung-status"
          role="alert"
          aria-live="assertive"
          aria-atomic="true"
          tabindex="-1"
          class="hidden mb-5 rounded-xl border px-4 py-3 text-sm leading-relaxed outline-none"
        ></div>

        <form id="bewerbung-form" method="post" action="/bewerbung/senden/" class="space-y-5">
          <input type="hidden" name="stelle" value="logopaedin-sprachtherapeut-duisburg" />
          <input type="hidden" name="quelle" id="quelle" value="" />
          <div class="absolute -left-[10000px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <p id="kontakt-progress" hidden class="text-xs font-bold uppercase tracking-widest text-slate-500" aria-live="polite">Schritt 1 von 2</p>
          <fieldset id="kontakt-anliegen" class="space-y-4">
            <legend id="anliegen-heading" tabindex="-1" class="mb-4 text-2xl font-semibold leading-tight">Was möchtest du als Erstes?</legend>
            <p id="kontakt-direkt-hint" hidden class="text-sm text-slate-500">Die ersten beiden Antworten führen direkt zu Schritt 2.</p>
            <div class="space-y-3">
              {Object.entries(CONTACT_INTENTS).map(([value, label]) => (
                <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold transition hover:border-simsek-green has-[:checked]:border-simsek-green has-[:checked]:bg-simsek-green/10 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-simsek-green">
                  <input type="radio" name="anliegen" value={value} required class="h-4 w-4 shrink-0 accent-simsek-green" />
                  <span class="flex-1">{label}</span>
                </label>
              ))}
            </div>
            <div id="kontakt-frage">
              <label for="nachricht" class="mb-2 block text-sm font-bold text-slate-800">Deine Frage <span class="font-normal text-slate-500">(optional)</span></label>
              <textarea id="nachricht" name="nachricht" rows="3" maxlength="1500" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-base text-slate-900 outline-none transition focus:border-simsek-green focus:ring-2 focus:ring-simsek-green/30"></textarea>
            </div>
            <button id="kontakt-weiter" type="button" hidden class="min-h-11 w-full rounded-lg bg-simsek-green px-5 py-3 text-sm font-bold text-white transition hover:bg-simsek-green/90 focus-visible:ring-2 focus-visible:ring-simsek-green focus-visible:ring-offset-2">Weiter</button>
          </fieldset>

          <button id="kontakt-zurueck" type="button" hidden aria-label="Zurück zum Anliegen" class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-800 transition hover:border-simsek-green hover:bg-simsek-green/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-simsek-green focus-visible:ring-offset-2">
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 19-7-7 7-7M5 12h14" /></svg>
            Zurück
          </button>

          <fieldset id="kontakt-daten" class="space-y-5">
            <legend id="kontakt-heading" tabindex="-1" class="mb-4 text-2xl font-semibold leading-tight">Wie erreichen wir dich?</legend>
            <p id="kontakt-auswahl" hidden class="text-sm text-slate-600"></p>
            <div>
              <label for="name" class="mb-2 block text-sm font-bold text-slate-800">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" minlength="1" maxlength="100" required aria-describedby="name-hint" class="min-h-11 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-base text-slate-900 outline-none transition focus:border-simsek-green focus:ring-2 focus:ring-simsek-green/30" />
              <p id="name-hint" class="mt-2 text-xs text-slate-500">Bitte gib deinen Namen an.</p>
            </div>

            <div>
              <label for="kontakt" class="mb-2 block text-sm font-bold text-slate-800">Telefon oder E-Mail</label>
              <input id="kontakt" name="kontakt" type="text" autocomplete="on" minlength="5" maxlength="160" pattern={CONTACT_PATTERN_SOURCE} required aria-describedby="kontakt-hint" class="min-h-11 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-base text-slate-900 outline-none transition focus:border-simsek-green focus:ring-2 focus:ring-simsek-green/30" />
              <p id="kontakt-hint" class="mt-2 text-xs text-slate-500">Zum Beispiel name@beispiel.de oder eine Telefonnummer mit Vorwahl.</p>
            </div>

            <p class="text-xs leading-relaxed text-slate-500">
              Mit dem Absenden verarbeiten wir deine Angaben zur Kontaktaufnahme. Details findest du in unserer
              <a href="/datenschutz/" class="inline-flex min-h-11 items-center font-semibold text-brand-primary underline underline-offset-2">Datenschutzerklärung</a>.
            </p>

            <button type="submit" class="min-h-11 w-full rounded-lg bg-simsek-green px-5 py-3 text-sm font-bold text-white shadow-md transition hover:bg-simsek-green/90 focus:outline-none focus:ring-2 focus:ring-simsek-green focus:ring-offset-2 disabled:cursor-wait disabled:opacity-70">
              Kontaktanfrage senden
            </button>
          </fieldset>
        </form>

      </div>

      {standalone && <ContactAlternatives />}
      {standalone && <p data-response-promise class="order-4 text-sm leading-relaxed text-slate-300"><strong class="text-white">Wir melden uns innerhalb von 12 Stunden</strong> – auch am Wochenende. Anfragen zwischen 20 und 8 Uhr beantworten wir am Morgen.</p>}

    </div>
  </div>
</section>

<style>
  [data-standalone] { padding-block: 1rem 3rem; }
  [data-standalone] > div { max-width: 38rem; }
  [data-standalone] > div > div { display: flex; flex-direction: column; gap: 1.5rem; }
  [data-standalone] .order-3 { order: 1; width: 100%; }
  [data-standalone] :global(#bewerbung-alternativen) { width: 100%; }
</style>

<script>
  import { contactFieldError } from '../lib/contact-validation.mjs';
  const form = document.querySelector('#bewerbung-form');
  const statusMessage = document.querySelector('#bewerbung-status');
  const knownFields = new Set(['name', 'kontakt', 'nachricht', 'anliegen']);
  const queryStatus = new URLSearchParams(window.location.search).get('status');

  const SOURCE_STORAGE_KEY = 'bewerbung-quelle';
  const SOURCE_PARAMS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  const MAX_SOURCE_LENGTH = 200;

  function readStoredSource() {
    try {
      return window.sessionStorage.getItem(SOURCE_STORAGE_KEY) ?? '';
    } catch {
      return '';
    }
  }

  function storeSource(value) {
    try {
      window.sessionStorage.setItem(SOURCE_STORAGE_KEY, value);
    } catch {
      // Privater Modus oder blockierter Speicher: Herkunft gilt nur fuer diesen Aufruf.
    }
  }

  function detectSource(search, referrer) {
    const params = new URLSearchParams(search);
    const utm = SOURCE_PARAMS
      .map((key) => (params.get(key) ?? '').trim())
      .filter(Boolean);

    if (utm.length > 0) return utm.join(' | ').slice(0, MAX_SOURCE_LENGTH);
    // Meta haengt fbclid auch ohne UTM an: belegt die Herkunft als Rueckfallebene.
    if (params.get('fbclid')) return 'meta | klick-id';

    if (referrer) {
      try {
        const host = new URL(referrer).hostname;
        if (host && host !== window.location.hostname) {
          return ('referrer | ' + host).slice(0, MAX_SOURCE_LENGTH);
        }
      } catch {
        // Unlesbarer Referrer zaehlt als direkt.
      }
    }

    return 'direkt';
  }

  const sourceField = document.querySelector('#quelle');
  if (sourceField instanceof HTMLInputElement) {
    // Erstkontakt gewinnt: wer ueber eine Kampagne kommt und danach im
    // Berufshandbuch weiterliest, behaelt die Kampagne als Herkunft.
    const detected = detectSource(window.location.search, document.referrer);
    if (detected !== 'direkt') storeSource(detected);
    sourceField.value = detected === 'direkt' ? (readStoredSource() || 'direkt') : detected;
  }

  function showStatus(message) {
    if (!(statusMessage instanceof HTMLElement)) return;

    statusMessage.textContent = message;
    statusMessage.className = 'mb-5 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-slate-800 outline-none';

    statusMessage.focus();
  }

  function clearFieldErrors() {
    for (const field of knownFields) {
      const input = document.getElementById(field);
      if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) {
        input.removeAttribute('aria-invalid');
        input.classList.remove('border-red-500', 'ring-2', 'ring-red-200');
      }
    }
  }

  if (queryStatus === 'invalid_form') {
    showStatus('Bitte prüfe deine Angaben und versuche es erneut.');
  } else if (queryStatus === 'service_unavailable') {
    showStatus('Der Versand ist momentan nicht möglich. Bitte schreib uns auf WhatsApp, ruf uns an oder schreib eine E-Mail.');
  }

  if (form instanceof HTMLFormElement) {
    const intentStep = form.querySelector('#kontakt-anliegen');
    const contactStep = form.querySelector('#kontakt-daten');
    const question = form.querySelector('#kontakt-frage');
    const message = form.querySelector('#nachricht');
    const progress = form.querySelector('#kontakt-progress');
    const next = form.querySelector('#kontakt-weiter');
    const back = form.querySelector('#kontakt-zurueck');
    const summary = form.querySelector('#kontakt-auswahl');
    const radios = [...form.querySelectorAll('input[name="anliegen"]')];
    let step = 1;

    function updateQuestion() {
      const asking = radios.some((radio) => radio.checked && radio.value === 'frage');
      question.hidden = !asking;
      message.disabled = !asking;
      next.hidden = !asking;
    }

    function showStep(value, focus = true) {
      step = value;
      intentStep.hidden = step !== 1;
      contactStep.hidden = step !== 2;
      back.hidden = step !== 2;
      contactStep.disabled = step !== 2;
      progress.textContent = `Schritt ${step} von 2`;
      if (step === 2) {
        const selected = radios.find((radio) => radio.checked);
        summary.textContent = selected?.closest('label')?.textContent.trim() ?? '';
      }
      if (focus) document.getElementById(step === 1 ? 'anliegen-heading' : 'kontakt-heading').focus();
    }

    function advance() {
      const selected = radios.find((radio) => radio.checked);
      if (!selected) { radios[0].reportValidity(); return; }
      if (!message.disabled && !validateInput(message)) { message.focus(); return; }
      showStep(2);
    }

    progress.hidden = summary.hidden = false;
    form.querySelector('#kontakt-direkt-hint').hidden = false;
    radios.forEach((radio) => {
      radio.addEventListener('change', updateQuestion);
      // Klick, Touch und Leertaste aktivieren; Pfeiltasten lassen die Auswahl erkunden.
      radio.addEventListener('click', () => {
        updateQuestion();
        if (radio.value !== 'frage') advance();
      });
    });
    next.addEventListener('click', advance);
    back.addEventListener('click', () => showStep(1));
    form.addEventListener('keydown', (event) => {
      if (step === 1 && event.key === 'Enter' && event.target !== message) {
        event.preventDefault();
        advance();
      }
    });
    form.noValidate = true;
    const validatedInputs = ['name', 'kontakt', 'nachricht'].map(id => document.getElementById(id));
    const touched = new Set();
    function validateInput(input) {
      const error = input.disabled ? '' : contactFieldError(input.id, input.value);
      let hint = document.getElementById(input.id + '-error');
      if (!hint) {
        hint = document.createElement('p');
        hint.id = input.id + '-error';
        hint.className = 'mt-2 text-sm text-red-700';
        hint.setAttribute('aria-live', 'polite');
        input.insertAdjacentElement('afterend', hint);
        input.setAttribute('aria-describedby', [input.getAttribute('aria-describedby'), hint.id].filter(Boolean).join(' '));
      }
      hint.textContent = error;
      hint.hidden = !error;
      input.setAttribute('aria-invalid', String(Boolean(error)));
      input.classList.toggle('border-red-500', Boolean(error));
      return !error;
    }
    for (const input of validatedInputs) {
      input.addEventListener('blur', () => { touched.add(input.id); validateInput(input); });
      input.addEventListener('input', () => { if (touched.has(input.id)) validateInput(input); });
    }
    updateQuestion();
    showStep(1, false);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (step === 1) { advance(); return; }
      clearFieldErrors();
      const invalid = validatedInputs.filter(input => { touched.add(input.id); return !validateInput(input); });
      if (invalid.length) {
        if (invalid.some(input => input.id === 'nachricht')) showStep(1, false);
        showStatus('Bitte korrigiere die markierten Angaben.');
        invalid[0].focus();
        return;
      }

      const submitButton = form.querySelector('button[type="submit"]');
      if (!(submitButton instanceof HTMLButtonElement)) return;

      submitButton.disabled = true;
      const formData = new FormData(form);
      const body = new URLSearchParams();

      for (const [name, value] of formData.entries()) {
        if (typeof value === 'string') body.append(name, value);
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
          },
          body,
          credentials: 'same-origin',
        });

        let payload;
        try {
          payload = await response.json();
        } catch {
          payload = null;
        }

        if (response.ok && payload && payload.ok === true) {
          window.location.assign('/bewerbung/danke/');
          return;
        }

        if (
          response.status === 422
          && payload
          && payload.ok === false
          && payload.code === 'invalid_form'
          && Array.isArray(payload.fields)
        ) {
          if (payload.fields.includes('anliegen') || payload.fields.includes('nachricht')) showStep(1, false);
          for (const field of payload.fields) {
            if (!knownFields.has(field)) continue;
            const input = document.getElementById(field);
            if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) {
              input.setAttribute('aria-invalid', 'true');
              input.classList.add('border-red-500', 'ring-2', 'ring-red-200');
            }
          }
          showStatus('Bitte prüfe deine Angaben und versuche es erneut.');
          return;
        }

        if (response.status === 503 && payload && payload.ok === false && payload.code === 'service_unavailable') {
          showStatus('Der Versand ist momentan nicht möglich. Bitte schreib uns auf WhatsApp, ruf uns an oder schreib eine E-Mail.');
          return;
        }

        showStatus('Die Kontaktanfrage konnte gerade nicht gesendet werden. Bitte schreib uns auf WhatsApp, ruf uns an oder schreib eine E-Mail.');
      } catch {
        showStatus('Die Kontaktanfrage konnte gerade nicht gesendet werden. Bitte schreib uns auf WhatsApp, ruf uns an oder schreib eine E-Mail.');
      } finally {
        submitButton.disabled = false;
      }
    });
  }
</script>
