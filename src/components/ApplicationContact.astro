---
import { CONTACT_PATTERN_SOURCE, QUALIFICATIONS } from '../lib/application-form.mjs';
import ContactAlternatives from './ContactAlternatives.astro';
import '../styles/recruiting-landing.css';

interface Props { standalone?: boolean; }
const { standalone = false } = Astro.props;
const Heading = standalone ? 'h1' : 'h2';
---

<section id="bewerbung" class="job-section contact-unity" aria-labelledby="job-contact-heading">
  {standalone && <a class="contact-back" href="/jobs/logopaedin-sprachtherapeut-duisburg/"><span aria-hidden="true">←</span> Zurück zur Stelle</a>}
  <Heading id="job-contact-heading">{standalone ? 'Lernen wir uns kennen.' : 'Lass uns einander kennenlernen.'}</Heading>
  <p id="kontakt-einstieg" class="job-invitation">Im ersten Gespräch geht es um deine Wunschstunden, deinen Einstieg, deine fachlichen Interessen und deine Fragen zum Praxisalltag. Du brauchst kein Anschreiben, ein Lebenslauf ist freiwillig.</p>
  <div class="contact-unity-shell">
    <div id="kontaktformular" tabindex="-1">
      <div id="bewerbung-status" role="alert" aria-live="assertive" aria-atomic="true" tabindex="-1" class="hidden mb-5 rounded-xl border px-4 py-3 text-sm leading-relaxed outline-none">
      </div>
      <form id="bewerbung-form" aria-describedby="kontakt-einstieg" method="post" action="/bewerbung/senden/" class="space-y-5">
        <input type="hidden" name="stelle" value="logopaedin-sprachtherapeut-duisburg">
        <div class="absolute -left-[10000px] h-px w-px overflow-hidden" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>
        <div class="contact-mast">
          <p id="kontakt-progress" hidden aria-live="polite">Schritt 1 von 2</p>
          <svg class="contact-dialog" viewBox="0 0 78 50" aria-hidden="true" focusable="false">
            <path fill="#7fb719" d="M43 19h21a9 9 0 0 1 9 9v7a9 9 0 0 1-9 9h-1l2 5-11-5H43a9 9 0 0 1-9-9v-7a9 9 0 0 1 9-9Z"/>
            <path fill="#1f85c2" d="M14 3h29a11 11 0 0 1 11 11v8a11 11 0 0 1-11 11H24l-12 8 2-8A11 11 0 0 1 3 22v-8A11 11 0 0 1 14 3Z"/>
            <path d="M15 18h4l3-5 4 11 5-14 4 11 3-3h5" fill="none" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="contact-steps">
          <fieldset id="kontakt-anliegen">
            <legend id="anliegen-heading" tabindex="-1">Worum geht es dir?</legend>
            <div class="contact-options">
              <label class="contact-option">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 21h18M5 21V5l9-2v18m0-14h5v14M8 8h2m-2 4h2m-2 4h2" /></svg>
                <span>Praxis kennenlernen</span>
                <input type="radio" name="anliegen" value="kennenlernen" required />
              </label>
              <label class="contact-option">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 8h18v12H3zM8 8V5h8v3M3 12q9 5 18 0m-9 0v3" /></svg>
                <span>Mehr zur Stelle erfahren</span>
                <input type="radio" name="anliegen" value="stelle" required />
              </label>
              <label class="contact-option">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 4h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7l-6 3v-3H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm2 6h10M7 14h6" /></svg>
                <span>Eine Frage stellen</span>
                <input type="radio" name="anliegen" value="frage" required />
              </label>
            </div>
          </fieldset>
          <fieldset id="kontakt-daten">
            <legend id="kontakt-heading" tabindex="-1">Wie erreichen wir dich?</legend>
            <div class="contact-fields">
              <div>
                <label for="name">Name</label>
                <input id="name" name="name" type="text" autocomplete="name" minlength="1" maxlength="100" required />
              </div>
              <div>
                <label for="kontakt">Telefon oder E-Mail</label>
                <input id="kontakt" name="kontakt" type="text" autocomplete="on" minlength="5" maxlength="160" pattern={CONTACT_PATTERN_SOURCE} required="" />
              </div>
              <div class="contact-details">
                <div id="kontakt-frage">
                  <label for="nachricht">Deine Frage <span>(optional)</span></label>
                  <textarea id="nachricht" name="nachricht" rows="2" maxlength="1500"></textarea>
                </div>
                <fieldset id="kontakt-abschluss" aria-describedby="abschluss-hint">
                  <legend id="abschluss-label">Dein Abschluss <span>(optional)</span></legend>
                  <select id="abschluss" name="abschluss" aria-labelledby="abschluss-label" aria-describedby="abschluss-hint">
                    <option value="">Keine Angabe</option>
                    {Object.entries(QUALIFICATIONS).map(([value, { label }]) => <option value={value}>{label}</option>)}
                  </select>
                  <p id="abschluss-hint">Hilft uns, das Gespräch vorzubereiten. Du kannst auch ohne Angabe absenden.</p>
                </fieldset>
              </div>
              <p class="contact-privacy">Mit dem Absenden verarbeiten wir deine Angaben zur Kontaktaufnahme. Details findest du in unserer <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
            </div>
          </fieldset>
        </div>
        <div class="contact-actions">
          <button id="kontakt-zurueck" type="button" hidden aria-label="Zurück zum Anliegen">Zurück</button>
          <button id="kontakt-weiter" type="button" hidden>Weiter <span aria-hidden="true">→</span></button>
          <button type="submit">Anfrage senden <span aria-hidden="true">→</span></button>
        </div>
      </form>
    </div>
    <div class="contact-unity-footer">
      <p data-response-promise="" class="mt-5 flex max-w-xl items-start gap-3 rounded-xl border border-simsek-green/30 bg-simsek-green/10 px-4 py-3 text-sm leading-relaxed text-white">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-simsek-green" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l2.5 2.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z">
          </path>
        </svg>
        <span>
          <strong class="font-bold">Wir melden uns innerhalb eines Arbeitstags persönlich bei dir.</strong></span>
      </p>
      <ContactAlternatives />
    </div>
  </div>
</section>

<script>
  import { contactFieldError } from '../lib/contact-validation.mjs';
  const form = document.querySelector('#bewerbung-form');
  const statusMessage = document.querySelector('#bewerbung-status');
  const knownFields = new Set(['name', 'kontakt', 'nachricht', 'anliegen', 'abschluss']);
  const queryStatus = new URLSearchParams(window.location.search).get('status');

  function showStatus(message) {
    if (!(statusMessage instanceof HTMLElement)) return;

    statusMessage.textContent = message;
    statusMessage.className = 'mb-5 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-slate-800 outline-none';

    statusMessage.focus();
  }

  function clearFieldErrors() {
    for (const field of knownFields) {
      const input = document.getElementById(field);
      if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement || input instanceof HTMLSelectElement) {
        input.removeAttribute('aria-invalid');
        input.classList.remove('border-red-500', 'ring-2', 'ring-red-200');
      }
    }
  }

  if (queryStatus === 'invalid_form') {
    showStatus('Bitte prüfe deine Angaben und versuche es erneut.');
  } else if (queryStatus === 'service_unavailable') {
    showStatus('Der Versand ist momentan nicht möglich. Bitte schreib uns auf WhatsApp, ruf uns an oder schreib eine E-Mail.');
  }

  if (form instanceof HTMLFormElement) {
    const intentStep = form.querySelector('#kontakt-anliegen');
    const contactStep = form.querySelector('#kontakt-daten');
    const question = form.querySelector('#kontakt-frage');
    const message = form.querySelector('#nachricht');
    const progress = form.querySelector('#kontakt-progress');
    const next = form.querySelector('#kontakt-weiter');
    const back = form.querySelector('#kontakt-zurueck');
    const submit = form.querySelector('button[type="submit"]');
    const radios = [...form.querySelectorAll('input[name="anliegen"]')];
    const qualification = form.querySelector('#kontakt-abschluss');
    let step = 1;

    function updateDetails() {
      const asking = radios.some(radio => radio.checked && radio.value === 'frage');
      question.inert = !asking;
      message.disabled = !asking;
      qualification.inert = asking;
      qualification.disabled = asking;
    }

    function showStep(value, focus = true) {
      step = value;
      intentStep.inert = step !== 1;
      contactStep.inert = step !== 2;
      contactStep.disabled = step !== 2;
      back.inert = submit.inert = step !== 2;
      next.inert = step !== 1;
      progress.textContent = `Schritt ${step} von 2`;
      if (focus) document.getElementById(step === 1 ? 'anliegen-heading' : 'kontakt-heading').focus({ preventScroll: true });
    }

    function advance() {
      if (!radios.some(radio => radio.checked)) { radios[0].reportValidity(); return; }
      updateDetails();
      showStep(2);
    }

    form.classList.add('has-steps');
    progress.hidden = next.hidden = back.hidden = false;
    next.addEventListener('click', advance);
    back.addEventListener('click', () => showStep(1));
    form.noValidate = true;
    const validatedInputs = ['name', 'kontakt', 'nachricht'].map(id => document.getElementById(id));
    const touched = new Set();
    function validateInput(input) {
      const error = input.disabled ? '' : contactFieldError(input.id, input.value);
      let hint = document.getElementById(input.id + '-error');
      if (!hint) {
        hint = document.createElement('p');
        hint.id = input.id + '-error';
        hint.className = 'mt-2 text-sm text-red-700';
        hint.setAttribute('aria-live', 'polite');
        input.insertAdjacentElement('afterend', hint);
        input.setAttribute('aria-describedby', [input.getAttribute('aria-describedby'), hint.id].filter(Boolean).join(' '));
      }
      hint.textContent = error;
      hint.hidden = !error;
      input.setAttribute('aria-invalid', String(Boolean(error)));
      input.classList.toggle('border-red-500', Boolean(error));
      return !error;
    }
    for (const input of validatedInputs) {
      input.addEventListener('blur', () => { touched.add(input.id); validateInput(input); });
      input.addEventListener('input', () => { if (touched.has(input.id)) validateInput(input); });
    }
    updateDetails();
    showStep(1, false);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (step === 1) { advance(); return; }
      clearFieldErrors();
      const invalid = validatedInputs.filter(input => { touched.add(input.id); return !validateInput(input); });
      if (invalid.length) {
        showStatus('Bitte korrigiere die markierten Angaben.');
        invalid[0].focus();
        return;
      }

      const submitButton = form.querySelector('button[type="submit"]');
      if (!(submitButton instanceof HTMLButtonElement)) return;

      submitButton.disabled = true;
      const formData = new FormData(form);
      const body = new URLSearchParams();

      for (const [name, value] of formData.entries()) {
        if (typeof value === 'string') body.append(name, value);
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
          },
          body,
          credentials: 'same-origin',
        });

        let payload;
        try {
          payload = await response.json();
        } catch {
          payload = null;
        }

        if (response.ok && payload && payload.ok === true) {
          window.location.assign('/bewerbung/danke/');
          return;
        }

        if (
          response.status === 422
          && payload
          && payload.ok === false
          && payload.code === 'invalid_form'
          && Array.isArray(payload.fields)
        ) {
          if (payload.fields.includes('anliegen')) showStep(1, false);
          for (const field of payload.fields) {
            if (!knownFields.has(field)) continue;
            const input = document.getElementById(field);
            if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement || input instanceof HTMLSelectElement) {
              input.setAttribute('aria-invalid', 'true');
              input.classList.add('border-red-500', 'ring-2', 'ring-red-200');
            }
          }
          showStatus('Bitte prüfe deine Angaben und versuche es erneut.');
          return;
        }

        if (response.status === 410 && payload?.code === 'applications_closed') {
          showStatus('Für diese Stelle werden aktuell keine Bewerbungen angenommen.');
          return;
        }

        if (response.status === 503 && payload && payload.ok === false && payload.code === 'service_unavailable') {
          showStatus('Der Versand ist momentan nicht möglich. Bitte schreib uns auf WhatsApp, ruf uns an oder schreib eine E-Mail.');
          return;
        }

        showStatus('Die Kontaktanfrage konnte gerade nicht gesendet werden. Bitte schreib uns auf WhatsApp, ruf uns an oder schreib eine E-Mail.');
      } catch {
        showStatus('Die Kontaktanfrage konnte gerade nicht gesendet werden. Bitte schreib uns auf WhatsApp, ruf uns an oder schreib eine E-Mail.');
      } finally {
        submitButton.disabled = false;
      }
    });
  }
</script>
