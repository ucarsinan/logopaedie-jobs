---
// src/components/Footer.astro
import Logo from './Logo.astro';
import PracticeBrand from './PracticeBrand.astro';

// "Cookie-Einstellungen" nur zeigen, wenn Analytics konfiguriert ist (sonst kein Banner).
const gaConfigured = !!import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const footerLinks = [
  { href: '/kontakt/', label: 'Kontakt', highlight: true },
  { href: '/#benefits', label: 'Vorteile' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/jobs/logopaedin-sprachtherapeut-duisburg/', label: 'Team & Stelle', highlight: true },
  { href: '/berufshandbuch/', label: 'Berufshandbuch' },
  { href: '/gehaltsrechner/', label: 'Gehaltsrechner' },
  { href: 'https://logopaedie-simsek.de/karriere/', label: 'Zur Praxis ↗', highlight: true, external: true },
];
---
<footer class="bg-slate-950 text-white pt-10 md:pt-14 lg:pt-20 pb-7 lg:pb-10 relative">
  <!-- Accent stripe (mirrors nav) -->
  <div class="absolute top-0 left-0 right-0 h-0.5 bg-simsek-green "></div>

  <div class="max-w-7xl mx-auto px-6">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 lg:gap-6 mb-4 sm:mb-5 lg:mb-6 text-left">
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="h-full rounded-2xl border border-white/10 bg-white/[0.025] p-3.5 sm:p-4">
          <p class="text-slate-400 text-[10px] font-bold uppercase tracking-widest mb-3">Karriereportal der</p>
          <div class="flex items-center gap-3 sm:gap-4 min-w-0">
            <Logo class="h-8 sm:h-9 w-auto shrink-0" />
            <span class="w-px h-9 sm:h-10 bg-white/10 shrink-0" aria-hidden="true"></span>
            <PracticeBrand dark compact class="min-w-0" />
          </div>
        </div>
      </div>
      <div class="h-full rounded-2xl border border-white/10 bg-white/[0.025] p-3.5 sm:p-4">
        <p class="text-slate-400 text-[10px] font-bold uppercase tracking-widest mb-2">Navigation</p>
        <ul class="flex flex-wrap gap-x-4 gap-y-0 text-[0.75rem] sm:grid sm:grid-cols-2 sm:gap-x-8 sm:gap-y-0.5 md:gap-y-3 sm:text-sm list-none p-0 max-w-sm">
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class={[
                  'inline-flex min-h-11 items-center py-1 sm:py-2 font-semibold whitespace-nowrap no-underline transition-colors duration-150',
                  link.highlight
                    ? 'text-simsek-green hover:text-white'
                    : 'text-slate-400 hover:text-white',
                ].join(' ')}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="h-full rounded-2xl border border-white/10 bg-white/[0.025] p-3.5 sm:p-4">
        <p class="text-slate-400 text-[10px] font-bold uppercase tracking-widest mb-2">Standort</p>
        <p class="text-sm text-slate-400 mb-1.5">Tonhallenstraße 21, 47051 Duisburg</p>
        <p class="text-xs text-slate-500 mb-3">(3. OG, Aufzug vorhanden)</p>
        <a
          href="mailto:info@logopaedie-simsek.de"
          class="inline-flex min-h-11 items-center gap-2 px-3.5 py-2.5 bg-simsek-green text-white text-[0.8rem] sm:text-sm font-bold rounded-lg shadow-md hover:shadow-lg hover:scale-[1.02] transition-all duration-200 no-underline"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          info@logopaedie-simsek.de
        </a>
      </div>
    </div>
    <div class="rounded-2xl border border-white/10 bg-white/[0.025] px-3.5 py-1.5 sm:px-4 flex flex-col sm:flex-row sm:items-center gap-0 sm:gap-4 justify-between text-[10px] uppercase font-bold text-slate-600">
      <p class="min-h-8 flex items-center">© {new Date().getFullYear()} Praxis für Logopädie Şimşek</p>
      <div class="flex flex-wrap gap-x-4 gap-y-0">
        <a href="/impressum/" class="inline-flex min-h-11 items-center no-underline hover:text-slate-400 transition-colors">Impressum</a>
        <a href="/datenschutz/" class="inline-flex min-h-11 items-center no-underline hover:text-slate-400 transition-colors">Datenschutz</a>
        {gaConfigured && (
          <button type="button" data-cc="show-preferencesModal" class="min-h-11 uppercase font-bold text-slate-600 hover:text-slate-400 transition-colors cursor-pointer bg-transparent border-0 p-0">Cookie-Einstellungen</button>
        )}
      </div>
    </div>
  </div>
</footer>
