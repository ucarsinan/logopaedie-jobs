---
interface Props { showApplication: boolean; }
const { showApplication } = Astro.props;
---

<section id="anforderungen" class="praxis-kapitel" aria-labelledby="stellen-titel">
  <h2 id="stellen-titel">Arbeiten bei uns</h2>
  {showApplication ? <p>Für unsere unbefristeten Stellen in Duisburg suchen wir Logopäd:innen und Sprachtherapeut:innen mit einem für die Behandlung gesetzlich Versicherter anerkannten Abschluss und sehr guten Deutschkenntnissen. Du kannst direkt nach der Ausbildung oder dem Studium einsteigen.</p> : <p>Aktuell ist keine Stelle zur Bewerbung freigegeben.</p>}
  <div class="praxis-stellenwege" id="apply">
    <a class="praxis-textlink" href="/jobs/logopaedin-sprachtherapeut-duisburg/">{showApplication ? 'Stelle und Konditionen ansehen' : 'Stellenstatus ansehen'} <span aria-hidden="true">→</span></a>
    {showApplication && <a class="praxis-textlink" href="/kontakt/">Unverbindlich Kontakt aufnehmen <span aria-hidden="true">→</span></a>}
  </div>
</section>
