---
import { RECRUITING_EMAIL_HREF } from '../lib/recruiting-whatsapp.mjs';
import RecruitingWhatsAppLink from './RecruitingWhatsAppLink.astro';
---

<div id="bewerbung-alternativen">
  <RecruitingWhatsAppLink variant="link" label="Schreib uns auf WhatsApp" />
  <details class="short-other">
    <summary>Andere Kontaktmöglichkeiten</summary>
    <div class="short-other-links">
      <a href="tel:+4915510062296" data-contact-icon="phone" class="short-contact-link min-h-11 w-full focus-visible:underline">
        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 0 1 2-2h3.28a1 1 0 0 1 .95.68l1.5 4.5a1 1 0 0 1-.5 1.21l-2.26 1.13a11.04 11.04 0 0 0 5.53 5.53l1.13-2.26a1 1 0 0 1 1.21-.5l4.5 1.5a1 1 0 0 1 .68.95V19a2 2 0 0 1-2 2h-1C10.82 21 3 13.18 3 4V5Z">
          </path>
        </svg>
        Jetzt anrufen
      </a>
      <a href={RECRUITING_EMAIL_HREF} data-contact-icon="mail" class="short-contact-link min-h-11 w-full focus-visible:underline">
        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z">
          </path>
        </svg>
        E-Mail schreiben
      </a>
      <p class="mt-4 text-xs leading-relaxed text-slate-300">Oder per Post: Praxis für Logopädie Şimşek, Tonhallenstraße 21, 47051 Duisburg.</p>
    </div>
  </details>
</div>
