---
// src/components/FaqSchema.astro
// FAQ Schema targeting "Logopädie Jobs Duisburg" search intent
// Generates expandable Q&A rich results in Google Search
const faqs = [
  { q: 'Welche Stellen bietet die Praxis für Logopädie Şimşek an?', a: 'Wir suchen mehrere staatlich anerkannte und zugelassene Logopäd:innen oder Sprachtherapeut:innen (m/w/d) für unbefristete Stellen in Vollzeit oder Teilzeit.' },
  { q: 'Wie hoch ist das Gehalt?', a: '3.840–4.338 € brutto im Monat bei Vollzeit mit 38,5 Stunden, je nach Erfahrung, plus jährliches Weihnachtsgeld. Die Grundlage sind 23–26 € brutto pro Stunde.' },
  { q: 'Ist Teilzeit möglich?', a: 'Ja. Teilzeit ist mit variablem Stundenumfang möglich; es gibt keine öffentlich genannte Mindeststundenzahl.' },
  { q: 'Ist eine Vier-Tage-Woche möglich?', a: 'Ja. Eine Vier-Tage-Woche ist möglich.' },
  { q: 'Wie werden Fortbildungen unterstützt?', a: 'Fortbildungen werden finanziell unterstützt. Du erhältst dafür zusätzliche freie Tage und wählst passende Fortbildungen selbst aus.' },
  { q: 'Sind Berufsanfänger:innen willkommen?', a: 'Ja. Du wirst intensiv und strukturiert eingearbeitet, dein Terminplan wächst schrittweise und eine Ansprechperson ist jederzeit erreichbar.' },
  { q: 'Welche Spezialisierungen gibt es?', a: 'Das Spektrum reicht von Pädiatrie und Frühförderung über Stottern und Poltern bis zu Aphasie, Dysarthrie, Dysphagie, Aussprache und Stimme. Du setzt eigene Schwerpunkte und musst nicht alle Bereiche behandeln.' },
  { q: 'Brauche ich Türkischkenntnisse oder einen Führerschein?', a: 'Nein. Sehr gute Deutschkenntnisse sind erforderlich. Weitere Sprachen sind willkommen, aber Türkisch und ein Führerschein sind keine Voraussetzung.' },
  { q: 'Wie kann ich Kontakt aufnehmen?', a: 'Über das kurze Formular direkt auf der konkreten Stellenanzeige auf LogopädieJobs.de, über WhatsApp für Bewerbungen, telefonisch unter +49 155 10062296, per E-Mail an social@logopaedie-simsek.de oder per Post an die Tonhallenstraße 21, 47051 Duisburg. Ein Lebenslauf ist freiwillig.' },
];
---

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": a
    }
  }))
})} />
