---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import PracticeBrand from './PracticeBrand.astro';
import RecruitingWhatsAppLink from './RecruitingWhatsAppLink.astro';
import sucheImg from '../assets/suche.jpg';
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-24 pb-12 md:pb-24 relative">
  <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-simsek-green/10 blur-[120px] rounded-full"></div>
    <div class="absolute top-1/2 -left-24 w-72 h-72 bg-simsek-blue/10 blur-[100px] rounded-full"></div>
  </div>

  <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">

    <div class="space-y-8">
      <PracticeBrand />

      <h1 class="text-3xl sm:text-5xl md:text-7xl font-semibold text-slate-900 leading-[1.05] tracking-tight normal-case">
        Logopädie Jobs<br/>
        <span class="text-simsek-green">Duisburg 2026.</span>
      </h1>

      <p class="text-base sm:text-xl text-slate-600 leading-relaxed max-w-lg">
        Vollzeit oder Teilzeit · <strong>Tonhallenstraße 21</strong>, direkt am Duisburger Hauptbahnhof. Arbeite in einem kollegialen Team mit klaren fachlichen Schwerpunkten.
      </p>

      <div class="grid grid-cols-2 gap-3 pt-4 sm:grid-cols-3">
        <RecruitingWhatsAppLink
          label="WhatsApp"
          class="w-full"
        />
        <a
          href="mailto:social@logopaedie-simsek.de?subject=Bewerbung"
          class="inline-flex min-h-11 w-full items-center justify-center gap-2 px-3 py-3 text-sm font-bold text-slate-700 no-underline rounded-lg border-2 border-slate-200 bg-white transition-all duration-200 hover:border-simsek-green hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-simsek-green"
        >
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          E-Mail
        </a>
        <a
          href="/jobs/logopaedin-sprachtherapeut-duisburg/"
          class="col-span-2 inline-flex min-h-11 w-full items-center justify-center gap-2.5 px-4 py-3 bg-white text-slate-700 text-sm font-bold rounded-lg border-2 border-slate-200 hover:border-simsek-green hover:text-slate-900 transition-all duration-200 no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-simsek-green sm:col-span-1"
        >
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5h6m-6 4h6m-6 4h3m-5 8h10a2 2 0 002-2V5.8a2 2 0 00-.586-1.414l-1.8-1.8A2 2 0 0015.2 2H7a2 2 0 00-2 2v15a2 2 0 002 2z" />
          </svg>
          Stellendetails
        </a>
      </div>
    </div>

    <div class="relative min-w-0">
      <div class="mb-10 flex justify-center lg:h-[72px] lg:items-center lg:mb-8">
        <div class="inline-flex max-w-full items-center gap-2 px-4 py-2 rounded-full bg-white border border-slate-200 shadow-sm animate-fade-in">
          <span class="w-2 h-2 shrink-0 rounded-full bg-simsek-green animate-pulse"></span>
          <span class="text-sm font-medium text-slate-600">Wir suchen Logopäd:innen und Sprachtherapeut:innen (m/w/d)</span>
        </div>
      </div>
      <div class="relative">

          <div class="rounded-3xl overflow-hidden shadow-2xl border-8 border-white relative bg-slate-50">
          <Image
            src={sucheImg}
            alt="Praxis für Logopädie Şimşek Duisburg – Modernes Therapiezimmer"
            width={900}
            height={700}
            class="w-full h-auto object-contain"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <div class="absolute -bottom-6 -left-4 md:-left-10 bg-white p-4 md:p-6 rounded-3xl shadow-xl border border-slate-100 z-20">
          <div class="flex items-center gap-4">
            <div>
              <p class="text-xs text-slate-500 font-medium tracking-widest uppercase">Modell</p>
              <p class="font-bold text-slate-900">4-Tage-Woche</p>
            </div>
          </div>
        </div>

        <div class="absolute -top-6 -right-2 md:-right-6 bg-white p-4 rounded-2xl shadow-lg border border-slate-100 hidden md:block z-20">
           <div class="flex items-center gap-2 px-2">
             <span class="text-simsek-green font-bold text-sm">23–26 €/Std.</span>
           </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in { animation: fade-in 0.8s ease-out forwards; }

</style>
