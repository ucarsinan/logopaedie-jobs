---
import { currentJob } from '../lib/current-job.mjs';
import Fachportal from '../layouts/Fachportal.astro';
import ApplicationContact from '../components/ApplicationContact.astro';
---

<Fachportal trail={[
  { name: 'Startseite', href: '/' },
  { name: 'Kontakt', href: Astro.url.pathname }
]} title="Unverbindlich kennenlernen | Praxis für Logopädie Şimşek" description={currentJob.showApplication ? "Lerne die Praxis für Logopädie Şimşek unverbindlich kennen. Wähle dein Anliegen und hinterlasse uns deine Kontaktdaten – ohne Anschreiben." : currentJob.presentation.pageDescription}>
  <div class="portal-inhalt kontaktseite">
    {currentJob.showApplication ? <ApplicationContact standalone /> : (
      <section class="job-section" id="bewerbung">
        <h1>Kontakt zur Praxis</h1>
        <p>{currentJob.presentation.statusMessage}</p>
        <p><a href="/praxis/#standort">Standort und allgemeiner Praxiskontakt</a></p>
      </section>
    )}
  </div>
</Fachportal>
