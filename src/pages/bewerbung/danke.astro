---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Danke | Praxis für Logopädie Şimşek"
  description="Ihre Kontaktanfrage für die Praxis für Logopädie Şimşek wurde gesendet."
  robots="noindex, nofollow"
>
  <Navigation />
  <main id="main-content" tabindex="-1">
    <section class="mx-auto max-w-3xl px-6 py-16 md:py-24">
      <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm md:p-12">
        <span class="inline-flex items-center rounded-full border border-simsek-green/30 bg-simsek-green/10 px-3 py-1 text-xs font-bold uppercase tracking-widest text-simsek-green">
          Kontaktanfrage
        </span>
        <h1 class="mt-6 text-3xl font-semibold leading-tight text-slate-900 md:text-5xl">
          Danke – deine Nachricht wurde gesendet.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-700">
          Deine Kontaktanfrage ist bei der Praxis eingegangen.
        </p>
        <p
          data-response-promise
          class="mt-6 flex max-w-2xl items-start gap-3 rounded-xl border border-simsek-green/30 bg-simsek-green/5 px-4 py-3 text-base leading-relaxed text-slate-800"
        >
          <svg class="mt-1 h-5 w-5 shrink-0 text-simsek-green" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l2.5 2.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          <span><strong class="font-bold">Wir melden uns innerhalb von 12 Stunden</strong> &ndash; auch am Wochenende. Anfragen zwischen 20 und 8 Uhr beantworten wir am Morgen.</span>
        </p>
        <a href="/jobs/logopaedin-sprachtherapeut-duisburg/" class="mt-8 inline-flex min-h-11 items-center justify-center rounded-lg bg-simsek-green px-5 py-3 text-sm font-bold text-white no-underline shadow-md transition hover:bg-simsek-green/90 focus:outline-none focus:ring-2 focus:ring-simsek-green focus:ring-offset-2">
          Zurück zur Stelle
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
