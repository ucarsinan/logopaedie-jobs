---
import { getCollection } from 'astro:content';
import Fachportal from '../../layouts/Fachportal.astro';

const beitraege = (await getCollection('ratgeber', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.topic !== b.data.topic) return a.data.topic.localeCompare(b.data.topic);
  if (a.data.priority !== b.data.priority) return a.data.priority - b.data.priority;
  return b.data.pubDate.getTime() - a.data.pubDate.getTime();
});

const topics = [
  {
    id: 'karriere-bewerbung',
    title: 'Karriere & Bewerbung',
    image: '/bilder/berufshandbuch/bewerbung.webp',
    description: 'Bewerbung, Quereinstieg, Anerkennung, Praxiswechsel und Stellenwahl konkret einordnen.',
  },
  {
    id: 'gehalt-arbeitsmodelle',
    title: 'Gehalt & Arbeitsmodelle',
    image: '/bilder/berufshandbuch/arbeitsmodell.webp',
    description: 'Gehalt in NRW, Teilzeit, 4-Tage-Woche und Arbeitszeitmodelle realistisch bewerten.',
  },
  {
    id: 'fachwissen-spezialisierung',
    title: 'Fachwissen & Spezialisierung',
    image: '/bilder/berufshandbuch/spezialisierung.webp',
    description: 'Frühe Sprachentwicklung, Bildschirmmedien, Mehrsprachigkeit und Stottern im Praxisalltag.',
  },
  {
    id: 'praxisalltag-region',
    title: 'Praxisalltag & Region',
    image: '/bilder/berufshandbuch/region.webp',
    description: 'Freie Praxis, Klinik, Duisburg, Ruhrgebiet und Teamkultur aus Berufsperspektive verstehen.',
  },
] as const;

type TopicId = typeof topics[number]['id'];

type ArticleGroup = { id?: string; title?: string; articles: typeof beitraege };
const groupedArticles = Object.fromEntries(topics.map(topic => {
  const articles = beitraege.filter(article => article.data.topic === topic.id);
  const groups: ArticleGroup[] = topic.id === 'fachwissen-spezialisierung'
    ? [
        { id: 'fruehe-sprache', title: 'Frühe Sprache und Bildschirmmedien', articles: articles.filter(article => article.data.series === 'fruehe-sprache') },
        { title: 'Weitere Fachthemen', articles: articles.filter(article => !article.data.series) },
      ]
    : [{ articles }];
  return [topic.id, groups];
})) as Record<TopicId, ArticleGroup[]>;

---

<Fachportal active="wissen" trail={[
  { name: 'Startseite', href: '/' },
  { name: 'Berufshandbuch', href: Astro.url.pathname }
]}
  title="Logopädie-Berufshandbuch — Karriere, Gehalt, Fachwissen | Logopädiejobs.de"
  description="Das Berufshandbuch für Logopädinnen und Sprachtherapeuten: Karriere, Gehalt, Bewerbung, Arbeitszeit, Fachwissen und Praxisalltag in NRW."
  canonicalUrl="https://xn--logopdiejobs-kcb.de/berufshandbuch/"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Logopädie-Berufshandbuch',
    description: 'Berufliche Orientierung der Praxis für Logopädie Şimşek mit Originalquellen zu Ausbildung, Gehalt, Arbeitszeit und Fachthemen.',
    url: 'https://xn--logopdiejobs-kcb.de/berufshandbuch/',
    inLanguage: 'de',
    isPartOf: {
      '@type': 'WebSite',
      name: 'Logopädiejobs.de',
      url: 'https://xn--logopdiejobs-kcb.de/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Logopädiejobs.de',
      url: 'https://xn--logopdiejobs-kcb.de/',
    },
    hasPart: beitraege.map((article) => ({
      '@type': 'Article',
      name: article.data.title,
      description: article.data.description,
      url: `https://xn--logopdiejobs-kcb.de/berufshandbuch/${article.id}/`,
      datePublished: article.data.pubDate.toISOString().split('T')[0],
    })),
  })} />

  <div class="portal-inhalt handbuch">
    <header>
      <h1>Berufs&shy;handbuch</h1>
      <p class="vorspann">Welche Frage beschäftigt dich gerade?</p>
    </header>
    <ul class="themen" id="einstiege" aria-label="Themen im Berufshandbuch">
      {topics.map(topic => <li><a href={`#${topic.id}`}>
        <img src={topic.image} alt="" width="160" height="160" />
        <div><h2>{topic.title} <span aria-hidden="true">↓</span></h2><p>{topic.description}</p></div>
      </a></li>)}
    </ul>
    <p class="bildhinweis">Die vier Themenbilder sind KI-Illustrationen.</p>
    {topics.map(topic => <section id={topic.id} class="registergruppe">
      <h2>{topic.title}</h2>
      {groupedArticles[topic.id].map(group => <div>
        {group.title && <h3 id={group.id} class="register-untertitel">{group.title}</h3>}
        <ul>{group.articles.map(article => <li>
          <a href={`/berufshandbuch/${article.id}/`}><strong>{article.data.title}</strong>
          <span>{article.data.description}</span></a>
        </li>)}</ul>
      </div>)}
      {topic.id === 'gehalt-arbeitsmodelle' && <a class="rueckweg" href="/gehaltsrechner/">Zum Gehaltsrechner →</a>}
      <a class="rueckweg" href="#einstiege">Zur Themenauswahl ↑</a>
    </section>)}
  </div>
</Fachportal>

<style>
  .register-untertitel { margin-block: 1.4rem .55rem; font-size: 1.25rem; scroll-margin-top: 5rem; }
</style>
