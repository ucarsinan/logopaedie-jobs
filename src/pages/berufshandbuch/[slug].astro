---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Fachportal from '../../layouts/Fachportal.astro';
import DefinitionBox from '../../components/DefinitionBox.astro';
import FAQBlock from '../../components/FAQBlock.astro';

export async function getStaticPaths() {
  const beitraege = await getCollection('ratgeber', ({ data }) => !data.draft);
  return beitraege.map((beitrag) => ({
    params: { slug: beitrag.id },
    props: { beitrag },
  }));
}

type Props = { beitrag: CollectionEntry<'ratgeber'> };
const { beitrag } = Astro.props;
const { Content } = await render(beitrag);
const pubDateFormatiert = beitrag.data.pubDate.toLocaleDateString('de-DE', {
  day: '2-digit', month: 'long', year: 'numeric',
});

const standDatum = beitrag.data.updatedDate ?? beitrag.data.pubDate;
const standDatumFormatiert = standDatum.toLocaleDateString('de-DE', {
  day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const redaktionName = 'Redaktion der Praxis für Logopädie Şimşek';

const canonicalURL = `https://xn--logopdiejobs-kcb.de/berufshandbuch/${beitrag.id}/`;

const alleArtikel = await getCollection('ratgeber', ({ data }) => !data.draft);
const verwandteArtikel = (beitrag.data.relatedArticles ?? [])
  .map((id) => alleArtikel.find((a) => a.id === id))
  .filter(Boolean) as CollectionEntry<'ratgeber'>[];
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": beitrag.data.title,
  "description": beitrag.data.description,
  "datePublished": beitrag.data.pubDate.toISOString(),
  "dateModified": (beitrag.data.updatedDate ?? beitrag.data.pubDate).toISOString(),
  "author": {
    "@type": "Organization",
    "name": redaktionName,
    "url": "https://xn--logopdiejobs-kcb.de/berufshandbuch/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Praxis für Logopädie Şimşek",
    "url": "https://logopaedie-simsek.de/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://xn--logopdiejobs-kcb.de/praxis-simsek-logo.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  ...(beitrag.data.heroImage ? { "image": `https://xn--logopdiejobs-kcb.de${beitrag.data.heroImage}` } : {}),
  "inLanguage": "de"
};

const faqSchema = beitrag.data.faq ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": beitrag.data.faq.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
} : null;
---

<Fachportal active="wissen" trail={[
  { name: 'Startseite', href: '/' },
  { name: 'Berufshandbuch', href: '/berufshandbuch/' },
  { name: beitrag.data.title, href: Astro.url.pathname }
]}
  title={`${beitrag.data.title} | Logopädiejobs.de`}
  description={beitrag.data.description}
  ogType="article" ogImage={beitrag.data.heroImage}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

  <!-- Reading progress bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 h-0.5 bg-simsek-green z-50 transition-[width] duration-100 ease-out pointer-events-none"
    style="width: 0%"
    role="progressbar"
    aria-label="Lesefortschritt"
  ></div>

  <div class="portal-inhalt leseseite">
    <article class="max-w-3xl mx-auto px-6 py-16 md:py-24">

      <!-- Article header -->
      <header class="mb-12">
        <span class="rubrikname">
          {beitrag.data.kategorie}
        </span>

        <h1 class="text-4xl md:text-5xl font-semibold text-slate-900 leading-tight mb-6">
          {beitrag.data.title}
        </h1>

        <p class="article-description text-xl text-slate-600 leading-relaxed mb-8">
          {beitrag.data.description}
        </p>

        <!-- Author / date row -->
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-simsek-green/10 flex items-center justify-center font-bold text-xs text-simsek-green shrink-0">
            {beitrag.data.author.charAt(0).toUpperCase()}
          </div>
          <div class="text-sm">
            <span class="font-semibold text-slate-700">{redaktionName}</span>
            <span class="mx-1.5 text-slate-300">·</span>
            <span class="text-slate-500">Veröffentlicht: {pubDateFormatiert}</span>
            {beitrag.data.updatedDate && <span class="block text-slate-500 mt-1">Überarbeitet: {standDatumFormatiert}</span>}
          </div>
        </div>

        <!-- Gradient divider -->
        <div class="mt-8 h-px bg-simsek-green "></div>
      </header>

      {beitrag.data.heroImage && (
        <figure class="handbuchfoto">
          <img src={beitrag.data.heroImage} alt={beitrag.data.heroImageAlt || beitrag.data.title} decoding="async" />
          {beitrag.data.heroImageCaption && <figcaption>{beitrag.data.heroImageCaption}</figcaption>}
        </figure>
      )}

      <!-- Definition box (AI SEO / speakable anchor) -->
      {beitrag.data.definition && <DefinitionBox definition={beitrag.data.definition} />}

      <!-- Article body -->
      <div class="article-body">
        <Content />
      </div>

      <!-- FAQ accordion -->
      {beitrag.data.faq && <FAQBlock faq={beitrag.data.faq} />}

      <!-- Related Articles -->
      {verwandteArtikel.length > 0 && (
        <aside class="mt-14 pt-8 border-t border-slate-100">
          <h3 class="text-xs font-semibold normal-case tracking-widest text-slate-600 mb-5">Weitere Artikel</h3>
          <ul class="space-y-3 list-none p-0">
            {verwandteArtikel.map((a) => (
              <li>
                <a
                  href={`/berufshandbuch/${a.id}/`}
                  class="flex items-center justify-between gap-4 p-4 rounded-2xl border border-slate-100 bg-white hover:border-simsek-green/30 hover:shadow-sm hover:shadow-simsek-green/10 transition-all duration-200 no-underline group"
                >
                  <div class="min-w-0">
                    <span class="rubrikname">
                      {a.data.kategorie}
                    </span>
                    <p class="text-sm font-semibold text-slate-800 leading-snug">{a.data.title}</p>
                  </div>
                  <svg class="w-4 h-4 shrink-0 text-slate-300 group-hover:text-simsek-green transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}

      {beitrag.data.topic === 'karriere-bewerbung' && (
        <p class="praxisverweis"><a href="/jobs/logopaedin-sprachtherapeut-duisburg/">Stellenbeschreibung der Praxis für Logopädie Şimşek ansehen</a></p>
      )}

      <!-- Article footer -->
      <footer class="mt-8 pt-6 border-t border-slate-100">
        <p class="text-xs text-slate-600">
          Stand: {standDatumFormatiert}. Herausgegeben von der Praxis für Logopädie Şimşek. Quellen stehen beim jeweiligen Beitrag; individuelle fachliche oder rechtliche Entscheidungen ersetzt der Artikel nicht.
        </p>
      </footer>

      {beitrag.id === 'ausbildung-nrw-2026' && (
        <a href="/berufseinstieg/#themen" class="mt-6 inline-flex min-h-11 items-center font-semibold underline underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4">← Zurück zu den vier Themen im Berufseinstieg</a>
      )}
      <a class="rueckweg" href={`/berufshandbuch/#${beitrag.data.series ?? beitrag.data.topic}`}>{beitrag.data.series ? '← Zur Reihe „Frühe Sprache und Bildschirmmedien“' : '← Zur Themenübersicht im Berufshandbuch'}</a>
    </article>
  </div>
</Fachportal>

<style>
  /* ─── Article body typography ─────────────────────────────────────────────── */

  :global(.article-body) {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #313131; /* slate-700 */
  }

  :global(.article-body p) {
    margin-bottom: 1.5rem;
  }

  :global(.article-body .article-table-scroll) {
    max-width: 100%;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  :global(.article-body .article-table-scroll:focus-visible) {
    outline: 2px solid rgb(65 101 20);
    outline-offset: 3px;
  }

  :global(.article-body table) {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    text-align: left;
  }

  :global(.article-body th), :global(.article-body td) {
    padding: 0.75rem;
    border-bottom: 1px solid rgb(65 101 20 / 0.2);
    vertical-align: top;
  }

  /* H2: simsek-green left accent bar */
  :global(.article-body h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: #101010; /* slate-900 */
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    padding-left: 1rem;
    border-left: 3px solid rgb(65 101 20);
    line-height: 1.3;
  }

  /* H3: simsek-blue left accent bar */
  :global(.article-body h3) {
    font-size: 1.25rem;
    font-weight: 700;
    color: #202020; /* slate-800 */
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-left: 0.875rem;
    border-left: 2px solid rgb(23 105 149);
    line-height: 1.35;
  }

  /* H4 */
  :global(.article-body h4) {
    font-size: 1.0625rem;
    font-weight: 700;
    color: #202020;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    color: #515151; /* slate-500 */
  }

  /* Unordered list */
  :global(.article-body ul) {
    list-style: none;
    padding-left: 0;
    margin-bottom: 1.5rem;
  }

  :global(.article-body ul li) {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
  }

  :global(.article-body ul li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.58em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(65 101 20); /* simsek-green */
  }

  /* Ordered list */
  :global(.article-body ol) {
    list-style: none;
    padding-left: 0;
    margin-bottom: 1.5rem;
    counter-reset: ol-counter;
  }

  :global(.article-body ol li) {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 0.5rem;
    counter-increment: ol-counter;
  }

  :global(.article-body ol li::before) {
    content: counter(ol-counter) '.';
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
    font-size: 0.875rem;
    color: rgb(65 101 20); /* simsek-green */
    line-height: 1.8;
  }

  /* Bold inside list items → simsek-blue */
  :global(.article-body li strong) {
    color: rgb(23 105 149); /* simsek-blue */
    font-weight: 600;
  }

  /* Blockquote */
  :global(.article-body blockquote) {
    border-left: 4px solid rgb(65 101 20);
    background: rgb(65 101 20 / 0.06);
    padding: 1.25rem 1.5rem;
    border-radius: 0 0.75rem 0.75rem 0;
    margin: 2rem 0;
  }

  :global(.article-body blockquote p) {
    margin-bottom: 0;
    font-style: italic;
    color: #515151; /* slate-600 */
  }

  /* Horizontal rule — gradient line */
  :global(.article-body hr) {
    border: none;
    height: 1px;
    background: rgb(65 101 20 / 0.3);
    margin: 3rem 0;
  }

  /* Links */
  :global(.article-body a) {
    color: rgb(23 105 149); /* simsek-blue */
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 0.15s;
  }

  :global(.article-body a:hover) {
    color: rgb(65 101 20); /* simsek-green */
  }

  /* Bold text */
  :global(.article-body strong) {
    font-weight: 600;
    color: #101010; /* slate-900 */
  }

  /* Inline code */
  :global(.article-body code) {
    background: rgb(65 101 20 / 0.1);
    color: rgb(23 105 149);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
    font-family: ui-monospace, 'Cascadia Code', monospace;
  }

  /* First paragraph — slightly larger lead */
  :global(.article-body > p:first-of-type) {
    font-size: 1.125rem;
    color: #515151; /* slate-600 */
    line-height: 1.75;
  }
</style>

<script is:inline>
  // Reading progress bar
  const bar = document.getElementById('reading-progress');
  const article = document.querySelector('article');

  function updateProgress() {
    if (!bar || !article) return;
    const rect = article.getBoundingClientRect();
    const total = article.scrollHeight - window.innerHeight;
    const scrolled = Math.max(0, -rect.top);
    const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
    bar.style.width = pct + '%';
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
</script>
