---
import TitelgeschichteBild from '../components/TitelgeschichteBild.astro';
import Werkzeuggruppen from '../components/Werkzeuggruppen.astro';
import Fachportal from '../layouts/Fachportal.astro';

const topics = [
  { id: 'arbeitsalltag', title: 'Arbeitsalltag', question: 'Wenn Angehörige das Gespräch übernehmen.', image: '/bilder/arbeitsalltag/angehoerigengespraech.webp', href: '/arbeitsalltag/angehoerigengespraech/' },
  { id: 'fachwissen', title: 'Fachwissen', question: 'Welche Spezialisierung interessiert mich?', image: '/bilder/berufshandbuch/spezialisierung.webp', href: '/berufshandbuch/#fachwissen-spezialisierung' },
  { id: 'berufseinstieg', title: 'Berufseinstieg & Wechsel', question: 'Wie komme ich in den Beruf?', image: '/bilder/berufseinstieg/ankommen.webp', href: '/berufseinstieg/' },
];
const werkzeuggruppen = [
  {
    titel: 'Gespräche vorbereiten',
    id: 'gespraeche',
    icon: 'M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-8l-6 4v-4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM7 9h10M7 13h6',
    links: [
      { titel: 'Gesprächskarte', href: '/werkzeuge/gespraechskarte/', text: 'Eine Frage und passende Wörter zum Zeigen auswählen.' },
      ...(import.meta.env.DEV ? [{ titel: 'Teammappe', href: '/vorschau/teammappe/', text: 'Üben zu Hause gemeinsam planen. Mit frei druckbarer Musterseite.' }] : []),
      { titel: 'Fragen zur Sprachbiografie', href: '/werkzeuge/sprachbiografie/', text: 'Einen Leitfaden für das Elterngespräch zusammenstellen.' },
    ],
  },
  {
    titel: 'Arbeitszeit und Gehalt',
    id: 'arbeitszeit-gehalt',
    icon: 'M20.5 12a8.5 8.5 0 1 1-17 0 8.5 8.5 0 0 1 17 0ZM12 7v5l3.5 2',
    links: [
      { titel: 'Wochenübersicht', href: '/werkzeuge/wochenuebersicht/', text: 'Geplante und tatsächliche Arbeitszeit vergleichen.' },
      { titel: 'Gehaltsrechner', href: '/gehaltsrechner/', text: 'Aus Stundenlohn und Wochenstunden das Monatsbrutto errechnen.' },
    ],
  },
];
---
<Fachportal ogImage="/bilder/berufseinstieg/zwischen-zwei-terminen.webp" title="Logopädie Jobs – Wissen, Praxisalltag und Berufseinstieg" description="Fachwissen, Gesprächskarten und Rechner für deinen logopädischen Alltag. Lerne die Praxis für Logopädie Şimşek in Duisburg und ihre Arbeitsbedingungen kennen.">
  <section class="titelgeschichte" aria-labelledby="titel">
    <h1 id="titel">Zwischen zwei<br />Terminen.</h1>
    <figure>
      <div class="titelbild">
        <TitelgeschichteBild sizes="(max-width: 60rem) 94vw, (min-width: 110rem) 81rem, 73vw" fetchpriority="high" alt="Eine Kollegin hebt eine Bildkarte an, während die andere ihre Beobachtungen notiert." />
        <a class="film-link" href="/arbeitsalltag/zwischen-zwei-terminen/#kurzfilm"><span aria-hidden="true">▶</span> Kurzfilm · 22 Sek.</a>
      </div>
      <figcaption>KI-Illustration aus dem Praxisalltag</figcaption>
    </figure>
    <p class="vorspann">Wo bleibt Zeit für Vorbereitung, Dokumentation und Austausch?</p>
    <div class="lesewege"><a href="/arbeitsalltag/zwischen-zwei-terminen/">Beitrag lesen</a><a class="werkzeug" href="/werkzeuge/wochenuebersicht/">Zur Wochenübersicht</a></div>
  </section>
  <section id="themen" class="ressorts">
    <h2>Themen entdecken</h2>
    <ul>{topics.map(topic => <li id={topic.id}><a href={topic.href}>
      <img src={topic.image} width="128" height="128" loading="lazy" alt="" />
      <div><p>{topic.title}</p><h3>{topic.question} <span aria-hidden="true">→</span></h3></div>
    </a></li>)}</ul>
  </section>
  <Werkzeuggruppen {werkzeuggruppen} />

<script is:inline>
  // Externe Lesezeichen zur früheren Praxis-Startseite enthalten weiterhin diese Fragmente.
  function followPracticeBookmark() {
    const fragments = ['#benefits', '#faq', '#apply', '#aufgaben', '#anforderungen', '#galerie', '#praxisbilder', '#map-notice'];
    if (fragments.includes(location.hash)) location.replace('/praxis/' + location.search + location.hash);
  }
  followPracticeBookmark();
  window.addEventListener('hashchange', followPracticeBookmark);
</script>
</Fachportal>
