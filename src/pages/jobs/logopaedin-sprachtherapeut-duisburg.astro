---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import sucheImg from '../../assets/suche.jpg';
import praxisImg from '../../assets/praxis-bild-2.jpg';

const canonicalURL = 'https://xn--logopdiejobs-kcb.de/jobs/logopaedin-sprachtherapeut-duisburg/';
const offizielleAnzeige = 'https://logopaedie-simsek.de/karriere/';
const pageTitle = 'Logopädin / Logopäde / Sprachtherapeutin / Sprachtherapeut (m/w/d) in Duisburg | Praxis Şimşek';
const pageDescription = 'Mehrere unbefristete Logopädie- und Sprachtherapie-Stellen in Duisburg: 22–26 € brutto/Std., 38,5 Std. Vollzeit, variable Teilzeit und 4-Tage-Woche.';
const reviewedOn = '29.08.2026';

const mailHref = 'mailto:info@logopaedie-simsek.de?subject=Bewerbung%20Logop%C3%A4din%20Duisburg&body=Hallo%20Frau%20%C5%9Eim%C5%9Fek-U%C3%A7ar,%0A%0Aich%20interessiere%20mich%20f%C3%BCr%20die%20Stelle%20als%20Logop%C3%A4din%20/%20Sprachtherapeutin%20in%20Duisburg.%0A%0AViele%20Gr%C3%BC%C3%9Fe';

const relatedLinks = [
  {
    href: '/berufshandbuch/logopaedin-duisburg-gesucht/',
    label: 'Logopädin in Duisburg gesucht',
    text: 'Warum die Praxis Şimşek für Therapeutinnen in Duisburg interessant ist.',
  },
  {
    href: '/berufshandbuch/arbeiten-duisburg/',
    label: 'Arbeiten in Duisburg',
    text: 'Warum Duisburg für Berufsanfängerinnen und Wechselwillige interessant sein kann.',
  },
  {
    href: '/berufshandbuch/gehalt-logopaedie-nrw/',
    label: 'Gehalt in der Logopädie NRW',
    text: 'Einordnung zu Gehalt, Benefits und Entwicklungsmöglichkeiten.',
  },
  {
    href: '/berufshandbuch/4-tage-woche-logopaedie/',
    label: '4-Tage-Woche in der Logopädie',
    text: 'Was das Modell im Praxisalltag bedeutet und wann es gut passt.',
  },
  {
    href: '/berufshandbuch/logopaedie-bewerbung-ohne-anschreiben/',
    label: 'Bewerbung ohne Anschreiben',
    text: 'So kann der erste Kontakt einfach und trotzdem professionell sein.',
  },
];

const faqs = [
  ['Was verdiene ich in der Praxis Şimşek?', 'Je nach Erfahrung 22–26 € brutto pro Stunde. Bei Vollzeit mit 38,5 Stunden entspricht das ungefähr 3.600–4.300 € brutto im Monat. Zusätzlich wird jedes Jahr Weihnachtsgeld gezahlt.'],
  ['Kann ich in Teilzeit arbeiten?', 'Ja. Teilzeit ist mit variablem Stundenumfang möglich; eine Mindeststundenzahl wird nicht vorgegeben.'],
  ['Ist eine Vier-Tage-Woche möglich?', 'Ja. Eine Vier-Tage-Woche ist möglich.'],
  ['Welche Qualifikation brauche ich?', 'Du brauchst eine staatlich anerkannte und zugelassene Ausbildung oder ein Studium in Logopädie beziehungsweise Sprachtherapie sowie sehr gute Deutschkenntnisse. Berufserfahrung, Türkischkenntnisse und Führerschein sind nicht erforderlich.'],
  ['Wie kann ich Kontakt aufnehmen?', 'Über das kurze Formular der Praxiswebsite, telefonisch unter 0203 34 86 86 90, per E-Mail an info@logopaedie-simsek.de oder per Post an die Tonhallenstraße 21, 47051 Duisburg. Ein Lebenslauf ist freiwillig.'],
] as const;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([name, text]) => ({
    '@type': 'Question',
    name,
    acceptedAnswer: {
      '@type': 'Answer',
      text,
    },
  })),
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={[
    { name: 'Startseite', url: 'https://xn--logopdiejobs-kcb.de/' },
    { name: 'Jobs', url: 'https://xn--logopdiejobs-kcb.de/jobs/' },
    { name: 'Logopädin Duisburg', url: canonicalURL },
  ]}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <Navigation />

  <main class="overflow-hidden">
    <section class="relative bg-white">
      <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10">
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-simsek-green/10 blur-[120px] rounded-full"></div>
        <div class="absolute top-1/3 -left-24 w-80 h-80 bg-simsek-blue/10 blur-[110px] rounded-full"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 md:pt-14 pb-12 md:pb-16">
        <nav class="mb-8 flex flex-wrap items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
          <a href="/" class="hover:text-simsek-blue no-underline">Startseite</a>
          <span>/</span>
          <a href="/jobs/" class="hover:text-simsek-blue no-underline">Jobs</a>
          <span>/</span>
          <span class="text-slate-800 font-semibold">Logopädin Duisburg</span>
        </nav>

        <div class="grid xl:grid-cols-[minmax(0,1.08fr)_minmax(360px,0.82fr)] gap-10 xl:gap-14 items-center">
          <div class="min-w-0 space-y-7 animate-fade-in relative z-10">
            <div class="inline-flex max-w-full items-center gap-2 px-4 py-2 rounded-full bg-white border border-slate-200 shadow-sm">
              <span class="w-2 h-2 rounded-full bg-simsek-green animate-pulse"></span>
              <span class="text-sm font-medium text-slate-600 truncate">Stelle aktiv · geprüft am {reviewedOn}</span>
            </div>

            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-simsek-blue mb-4">Praxis für Logopädie Şimşek</p>
              <h1 class="max-w-4xl text-[clamp(1.75rem,8vw,2.25rem)] sm:text-5xl lg:text-6xl font-bold text-slate-900 leading-[1.03] tracking-tight uppercase">
                Logopädin /<br class="hidden sm:block" />
                <span class="text-transparent bg-clip-text bg-linear-to-r from-simsek-blue to-simsek-green">Sprachtherapeutin</span><br />
                gesucht.
              </h1>
            </div>

            <p class="text-base sm:text-xl text-slate-600 leading-relaxed max-w-2xl">
              Mehrere unbefristete Stellen in Duisburg-Mitte: 22–26 € brutto pro Stunde, 38,5 Stunden Vollzeit, variable Teilzeit und Vier-Tage-Woche.
            </p>

            <div class="flex flex-col sm:flex-row flex-wrap gap-3 pt-2">
              <a href={mailHref} class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-linear-to-r from-simsek-green to-simsek-blue text-white text-sm font-bold rounded-full shadow-md shadow-simsek-green/20 hover:shadow-lg hover:shadow-simsek-green/30 hover:scale-[1.03] active:scale-[0.97] transition-all duration-200 no-underline">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                Per E-Mail bewerben
              </a>
            </div>
          </div>

          <div class="min-w-0 relative xl:justify-self-end">
            <div class="relative group">
              <div class="rounded-[2rem] md:rounded-[3rem] overflow-hidden shadow-2xl border-8 border-white relative bg-slate-50 max-w-[620px] xl:max-w-[520px] mx-auto xl:mr-0">
                <Image
                  src={sucheImg}
                  alt="Therapieraum der Praxis für Logopädie Şimşek in Duisburg"
                  width={900}
                  height={506}
                  class="w-full h-auto object-cover transform transition duration-700 group-hover:scale-105"
                  loading="eager"
                  fetchpriority="high"
                />
                <div class="absolute inset-0 bg-linear-to-t from-slate-950/20 via-transparent to-transparent"></div>
              </div>

              <div class="absolute -bottom-6 left-2 md:-left-4 xl:-left-10 bg-white p-4 md:p-6 rounded-3xl shadow-xl border border-slate-100 z-20">
                <div class="flex items-center gap-4">
                  <div>
                    <p class="text-xs text-slate-500 font-medium tracking-widest uppercase">Modell</p>
                    <p class="font-bold text-slate-900">4-Tage-Woche</p>
                  </div>
                </div>
              </div>

              <div class="absolute -top-4 -right-2 md:-right-6 bg-white p-4 rounded-2xl shadow-lg border border-slate-100 hidden sm:block z-20">
                <div class="flex items-center gap-2 px-2">
                  <span class="text-simsek-blue font-bold text-sm">Fortbildung + freie Tage</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <dl class="mt-14 grid sm:grid-cols-3 gap-4">
          {[
            ['Arbeitszeit', '38,5 Std. Vollzeit', 'Teilzeit und 4-Tage-Woche möglich'],
            ['Standort', '47051 Duisburg', 'Vor Ort, 2 Min. vom Hbf; keine Dienstreisen'],
            ['Gehalt', '22–26 €/Std.', 'Plus jährliches Weihnachtsgeld'],
          ].map(([label, value, note]) => (
            <div class="p-px rounded-3xl bg-linear-to-br from-simsek-green/40 via-slate-100 to-simsek-blue/40">
              <div class="h-full rounded-[calc(1.5rem-1px)] bg-white p-5 shadow-sm">
                <dt class="text-xs uppercase font-bold tracking-widest text-slate-400 mb-2">{label}</dt>
                <dd class="text-2xl font-bold text-slate-900">{value}</dd>
                <p class="text-sm text-slate-500 mt-1">{note}</p>
              </div>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="py-14 md:py-24 bg-slate-50 relative">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row justify-between items-end mb-10 md:mb-16 gap-5">
          <div class="max-w-3xl">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-simsek-green/10 text-simsek-green border border-simsek-green/20 mb-4">
              Stellendetails
            </span>
            <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4 leading-tight">Ein Logopädie-Job, der fachlich klar und menschlich planbar ist</h2>
            <div class="h-px bg-linear-to-r from-simsek-green via-simsek-blue/40 to-transparent mb-4"></div>
            <p class="text-lg text-slate-600 leading-relaxed">
              Du bekommst verlässlichen Rahmen, fachlichen Austausch und genug Flexibilität, damit Therapiequalität und Arbeitsleben zusammenpassen.
            </p>
          </div>
          <a href={mailHref} class="hidden md:inline-flex items-center justify-center px-6 py-3 bg-white text-slate-700 text-sm font-bold rounded-full border-2 border-slate-200 hover:border-simsek-green hover:text-slate-900 transition-all duration-200 no-underline">
            Kurze Nachricht senden
          </a>
        </div>

        <div class="grid lg:grid-cols-[0.82fr_1.18fr] gap-8 lg:gap-12 items-start">
          <aside class="lg:sticky lg:top-24 bg-white border border-slate-100 shadow-xl shadow-slate-200/50 rounded-[2rem] p-6 md:p-8">
            <p class="text-xs font-bold uppercase tracking-widest text-simsek-blue mb-3">Kurzprofil</p>
            <h3 class="text-2xl font-bold text-slate-900 mb-5">Logopädie-Job in Duisburg-Mitte</h3>
            <ul class="space-y-3 text-sm text-slate-700">
              <li class="flex gap-3"><span class="text-simsek-green font-bold">✓</span><span>22–26 € brutto pro Stunde; bei Vollzeit ungefähr 3.600–4.300 € brutto im Monat plus jährliches Weihnachtsgeld</span></li>
              <li class="flex gap-3"><span class="text-simsek-green font-bold">✓</span><span>38,5 Stunden Vollzeit, Teilzeit mit variablem Umfang und Vier-Tage-Woche</span></li>
              <li class="flex gap-3"><span class="text-simsek-green font-bold">✓</span><span>Unbefristeter Vertrag, 30 Urlaubstage bei fünf Arbeitstagen, anteilig bei weniger Arbeitstagen, sowie Heiligabend und Silvester frei</span></li>
              <li class="flex gap-3"><span class="text-simsek-green font-bold">✓</span><span>Eigene Terminplanung mit iPrax; keine regelmäßigen Überstunden, Wochenend- oder Feiertagsarbeit; Ausnahmen werden ausgeglichen</span></li>
              <li class="flex gap-3"><span class="text-simsek-green font-bold">✓</span><span>Finanziell und zeitlich unterstützte Fortbildungen mit freier Auswahl</span></li>
              <li class="flex gap-3"><span class="text-simsek-green font-bold">✓</span><span>Intensive Einarbeitung, schrittweiser Terminaufbau und jederzeit eine Ansprechperson</span></li>
              <li class="flex gap-3"><span class="text-simsek-green font-bold">✓</span><span>Eigene fachliche Schwerpunkte; Berufsanfänger:innen willkommen</span></li>
            </ul>
            <a href={mailHref} class="mt-6 w-full inline-flex items-center justify-center gap-2.5 px-5 py-3 bg-linear-to-r from-simsek-green to-simsek-blue text-white text-sm font-bold rounded-full shadow-md shadow-simsek-green/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 no-underline">
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              Kurze Nachricht senden
            </a>
          </aside>

          <div class="grid sm:grid-cols-2 gap-5">
            {[
              ['Vier-Tage-Woche', 'Das Modell ist ebenso möglich wie Vollzeit mit 38,5 Stunden oder Teilzeit mit variablem Umfang.'],
              ['Fortbildung', 'Du erhältst finanzielle Unterstützung, zusätzliche freie Tage und wählst passende Fortbildungen selbst.'],
              ['Eigene Planung', 'Termine, Pausen und Puffer planst du auf Vertrauensbasis mit iPrax selbst.'],
              ['Intensive Einarbeitung', 'Dein Terminplan wächst schrittweise und eine Ansprechperson ist jederzeit für dich da.'],
              ['iPad und Material', 'iPad mit iPrax und benötigter Software, auch privat nutzbar, plus benötigtes Therapiematerial.'],
              ['Parken und Verpflegung', 'Nach Möglichkeit Parkplatz, sonst Parkkostenunterstützung; dazu kostenlose Snacks, Getränke und Küche.'],
            ].map(([title, text], index) => (
              <div class="p-px rounded-4xl bg-slate-100 hover:bg-linear-to-br hover:from-simsek-green hover:to-simsek-blue transition-all duration-300 group/card">
                <div class="h-full p-6 rounded-[1.9rem] bg-white group-hover/card:bg-slate-50 transition-colors duration-200">
                  <div class:list={[
                    'w-12 h-12 rounded-2xl bg-slate-50 shadow-sm flex items-center justify-center mb-5 font-bold group-hover/card:scale-110 transition-transform duration-200',
                    index % 2 === 0 ? 'text-simsek-green' : 'text-simsek-blue',
                  ]}>
                    {String(index + 1).padStart(2, '0')}
                  </div>
                  <h3 class="text-xl font-bold text-slate-900 mb-3">{title}</h3>
                  <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-14 md:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-[0.92fr_1.08fr] gap-8 lg:gap-12 items-start">
        <div class="space-y-5">
          <div class="relative rounded-[2rem] md:rounded-[3rem] overflow-hidden shadow-2xl border-8 border-white bg-slate-50 aspect-[16/11] lg:aspect-[5/4]">
            <Image
              src={praxisImg}
              alt="Moderner Behandlungsraum der Logopädie Şimşek in Duisburg"
              width={900}
              height={506}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <div class="grid sm:grid-cols-3 gap-3">
            {[
              ['Einarbeitung', 'klar begleitet'],
              ['Austausch', 'kurze Wege'],
              ['Entwicklung', 'Fortbildung + freie Tage'],
            ].map(([label, value]) => (
              <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4">
                <p class="text-[10px] font-bold uppercase tracking-widest text-simsek-green mb-1">{label}</p>
                <p class="text-sm font-semibold text-slate-800">{value}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="space-y-6 lg:pt-3">
          <div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-simsek-blue/10 text-simsek-blue border border-simsek-blue/20 mb-4">
              Alltag in der Praxis
            </span>
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900 leading-tight mb-5">Was dich erwartet</h2>
            <div class="h-px bg-linear-to-r from-simsek-green via-simsek-blue/40 to-transparent mb-6"></div>
            <div class="space-y-4 text-base md:text-lg text-slate-600 leading-relaxed">
              <p>
                Du arbeitest in einer etablierten logopädischen Praxis in der Duisburger Innenstadt. Unsere Patientinnen und Patienten kommen unter anderem mit Sprachentwicklungsstörungen, Aphasie, Dysarthrie, Dysphagie, Stottern, Poltern und weiteren logopädischen Fragestellungen zu uns.
              </p>
              <p>Therapieeinheiten dauern je nach ärztlicher Verordnung 30, 45 oder 60 Minuten. Du planst Termine, Pausen, Puffer und tägliche Behandlungszahl selbst. Dokumentation, Berichte und Organisation sind eingeplante Arbeitszeit. Patientenseitige Ausfälle musst du nicht durch doppelte Arbeit nachholen.</p>
              <p>Die Stellen sind unbefristet. Die Probezeit beträgt normalerweise sechs Monate und kann abhängig von deiner Erfahrung auf drei Monate verkürzt werden; den Eintrittstermin stimmen wir individuell ab. Hausbesuche sind keine Voraussetzung und nur auf deinen Wunsch möglich.</p>
              <p>Du arbeitest vor Ort in einem vierköpfigen Team mit flachen Hierarchien und fachlicher Entscheidungsfreiheit. Wöchentliche Teamsitzungen, interne Schulungen und Supervision gehören dazu. Eine jährliche Weihnachtsfeier und weitere Aktivitäten plant ihr gemeinsam. Wünsche bei der Arbeitszeitplanung werden berücksichtigt; kurzfristige private Termine während des Arbeitstags können ermöglicht werden.</p>
              <p>
                Wir suchen nicht nach Perfektion. Wichtiger ist, dass du fachlich wachsen möchtest, gerne im Team arbeitest und Praxisalltag suchst, in dem Therapiequalität und Arbeitsleben zusammenpassen.
              </p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            {[
              ['01', 'Ankommen', 'Klare Einarbeitung, feste Ansprechpersonen und kurze Wege.'],
              ['02', 'Therapieren', 'Diagnostik und Therapie bei Kindern, Jugendlichen und Erwachsenen.'],
              ['03', 'Dokumentieren und beraten', 'Dokumentation, Elternberatung, Fallbesprechungen und fachliche Rückendeckung.'],
              ['04', 'Wachsen', 'Fortbildungen werden finanziell und mit zusätzlichen freien Tagen unterstützt.'],
            ].map(([step, title, text]) => (
              <div class="rounded-3xl bg-slate-50 border border-slate-100 p-4 md:p-5">
                <p class="text-xs font-bold uppercase tracking-widest text-simsek-green mb-2">{step}</p>
                <h3 class="font-bold text-slate-900 mb-2">{title}</h3>
                <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-8 md:py-14 bg-slate-900 text-white rounded-3xl md:rounded-[3rem] mx-4 md:mx-6 my-6 md:my-10 overflow-hidden relative">
      <div class="absolute -top-24 -right-24 w-80 h-80 bg-simsek-green/20 blur-[100px] rounded-full"></div>
      <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-simsek-blue/20 blur-[100px] rounded-full"></div>
      <div class="max-w-4xl mx-auto px-6 relative z-10 text-center">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-simsek-green/20 text-simsek-green border border-simsek-green/30 mb-4">
          Bewerbung
        </span>
        <h2 class="text-3xl md:text-5xl font-bold mb-4 leading-tight">Erst unverbindlich kennenlernen</h2>
        <div class="h-px bg-linear-to-r from-transparent via-simsek-green/40 to-transparent mb-5"></div>
        <p class="text-slate-300 leading-relaxed max-w-2xl mx-auto mb-7">
          Eine klassische Bewerbung ist nicht nötig. Nutze das kurze Formular auf der Praxiswebsite, ruf an, schreib eine E-Mail oder sende Post. Ein Lebenslauf ist freiwillig; Hospitation oder Probearbeit sind möglich.
        </p>
        <p class="text-slate-300 leading-relaxed max-w-2xl mx-auto mb-7">
          Emel Şimşek-Uçar · 0203 – 34 86 86 90 · info@logopaedie-simsek.de · Tonhallenstraße 21, 47051 Duisburg
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={offizielleAnzeige} class="inline-flex items-center justify-center px-8 py-4 bg-white text-slate-900 text-sm font-bold rounded-full no-underline">Zum Kurzformular</a>
          <a href={mailHref} class="inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-linear-to-r from-simsek-green to-simsek-blue text-white text-sm font-bold rounded-full shadow-md shadow-simsek-green/30 hover:scale-[1.03] active:scale-[0.97] transition-all duration-200 no-underline">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            E-Mail schreiben
          </a>
        </div>
      </div>
    </section>

    <section class="py-12 md:py-18 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="mb-8 max-w-3xl">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-simsek-blue/10 text-simsek-blue border border-simsek-blue/20 mb-4">
            Mehr Orientierung
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 leading-tight mb-4">Weitere Themen rund um den Logopädie-Job in Duisburg</h2>
          <p class="text-slate-600 leading-relaxed">
            Diese Artikel aus dem Berufshandbuch helfen dir, Arbeitsmodell, Praxisalltag und Bewerbung besser einzuordnen.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {relatedLinks.map((link) => (
            <a href={link.href} class="group p-px rounded-3xl bg-slate-100 hover:bg-linear-to-br hover:from-simsek-green hover:to-simsek-blue transition-all duration-300 no-underline">
              <div class="h-full rounded-[calc(1.5rem-1px)] bg-slate-50 group-hover:bg-white p-5 transition-colors duration-200">
                <h3 class="font-bold text-slate-900 mb-2 leading-snug">{link.label}</h3>
                <p class="text-sm text-slate-600 leading-relaxed">{link.text}</p>
                <span class="mt-4 inline-flex text-xs font-bold uppercase tracking-widest text-simsek-green">Lesen →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 md:py-24 bg-slate-50">
      <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-8">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-simsek-green/10 text-simsek-green border border-simsek-green/20 mb-4">
            Fragen
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900">Häufige Fragen zur Stelle</h2>
        </div>
        <div class="space-y-4">
          {faqs.map(([q, a]) => (
            <details class="group rounded-2xl bg-white border border-slate-100 overflow-hidden shadow-sm">
              <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none font-semibold text-slate-900">
                {q}
                <span class="text-simsek-green group-open:rotate-45 transition-transform duration-200">+</span>
              </summary>
              <p class="px-5 pb-4 text-sm text-slate-600 leading-relaxed">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }

</style>
