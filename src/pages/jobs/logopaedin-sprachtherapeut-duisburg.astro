const canonicalURL = 'https://xn--logopdiejobs-kcb.de/jobs/logopaedin-sprachtherapeut-duisburg/';
const pageTitle = 'Logopädin / Logopäde / Sprachtherapeutin / Sprachtherapeut (m/w/d) in Duisburg | Praxis für Logopädie Şimşek';
const pageDescription = 'Logopädie-Job in Duisburg: 3.840–4.338 € brutto/Monat bei Vollzeit + Weihnachtsgeld. Entscheide im Team mit. Lerne Emel und uns unverbindlich kennen.';

const relatedLinks = [
  {
    href: '/berufshandbuch/logopaedin-duisburg-gesucht/',
    label: 'Logopädin in Duisburg gesucht',
    text: 'Warum die Praxis für Logopädie Şimşek für Therapeutinnen in Duisburg interessant ist.',
  },
  {
    href: '/berufshandbuch/arbeiten-duisburg/',
    label: 'Arbeiten in Duisburg',
    text: 'Warum Duisburg für Berufsanfängerinnen und Wechselwillige interessant sein kann.',
  },
  {
    href: '/berufshandbuch/gehalt-logopaedie-nrw/',
    label: 'Gehalt in der Logopädie NRW',
    text: 'Einordnung zu Gehalt, Benefits und Entwicklungsmöglichkeiten.',
  },
  {
    href: '/berufshandbuch/4-tage-woche-logopaedie/',
    label: '4-Tage-Woche in der Logopädie',
    text: 'Was das Modell im Praxisalltag bedeutet und wann es gut passt.',
  },
  {
    href: '/berufshandbuch/logopaedie-bewerbung-ohne-anschreiben/',
    label: 'Bewerbung ohne Anschreiben',
    text: 'So kann der erste Kontakt einfach und trotzdem professionell sein.',
  },
];

const faqs = [
  ['Was verdiene ich in der Praxis für Logopädie Şimşek?', '3.840–4.338 € brutto im Monat bei Vollzeit mit 38,5 Stunden, je nach Erfahrung, plus jährliches Weihnachtsgeld. Die Grundlage sind 23–26 € brutto pro Stunde.'],
  ['Was bedeutet Mitsprache bei euch?', 'Du entscheidest mit uns, wie wir unseren Praxisalltag gestalten. Wir tauschen uns fachlich aus und stimmen uns im Team ab. Emel therapiert selbst mit und übernimmt als Inhaberin zusätzlich die organisatorische Verantwortung.'],
  ['Ist Zeit für Doku und Vorbereitung eingeplant?', 'Ja. Deine Dokumentation sowie Vor- und Nachbereitung gehören zur Arbeitszeit. Wir orientieren uns an realistischen Therapiezahlen und besprechen die Planung gemeinsam. Richtwerte geben Orientierung und sind keine starren Vorgaben.'],
  ['Kann ich in Teilzeit arbeiten?', 'Ja. Teilzeit ist mit variablem Stundenumfang möglich; eine Mindeststundenzahl wird nicht vorgegeben.'],
  ['Ist eine Vier-Tage-Woche möglich?', 'Ja. Eine Vier-Tage-Woche ist möglich.'],
  ['Welche Qualifikation brauche ich?', 'Du brauchst eine staatlich anerkannte und zugelassene Ausbildung oder ein Studium in Logopädie beziehungsweise Sprachtherapie sowie sehr gute Deutschkenntnisse. Berufserfahrung, Türkischkenntnisse und Führerschein sind nicht erforderlich.'],
  ['Wie kann ich Kontakt aufnehmen?', 'Über das kurze Formular auf unserer Kontaktseite auf LogopädieJobs.de, über WhatsApp, telefonisch unter +49 155 10062296, per E-Mail an social@logopaedie-simsek.de oder per Post an die Tonhallenstraße 21, 47051 Duisburg. Ein Lebenslauf ist freiwillig.'],
] as const;

const jobPostingSchema = {
  '@context': 'https://schema.org/',
  '@type': 'JobPosting',
  title: 'Logopädin / Logopäde / Sprachtherapeutin / Sprachtherapeut (m/w/d)',
  description:
    '<p>Die Praxis für Logopädie Şimşek sucht mehrere Logopädinnen, Logopäden, Sprachtherapeutinnen oder Sprachtherapeuten (m/w/d) für unbefristete Stellen in Duisburg-Mitte.</p><p>Du arbeitest in der Diagnostik und Therapie mit Kindern, Jugendlichen und Erwachsenen. Dokumentation, Elternberatung, Fallbesprechungen und fachlicher Austausch gehören ebenfalls zur Stelle. Therapieeinheiten dauern je nach ärztlicher Verordnung 30, 45 oder 60 Minuten. Dokumentation, Vor- und Nachbereitung, Berichte und Organisation sind eingeplante Arbeitszeit.</p><p>Vorausgesetzt werden eine staatlich anerkannte und zugelassene Ausbildung oder ein Studium in Logopädie beziehungsweise Sprachtherapie sowie sehr gute Deutschkenntnisse. Berufserfahrung ist nicht erforderlich; Berufsanfängerinnen und Berufsanfänger sind willkommen.</p><p>Möglich sind Vollzeit mit 38,5 Stunden, Teilzeit mit variablem Umfang und eine Vier-Tage-Woche. Die Vergütung beträgt je nach Erfahrung 23 bis 26 Euro brutto pro Stunde, bei Vollzeit 3.840–4.338 Euro brutto im Monat. Du entscheidest im Team mit, wie wir den Praxisalltag gestalten. Emel therapiert selbst mit. Hinzu kommen jährliches Weihnachtsgeld, 30 Urlaubstage bei fünf Arbeitstagen, finanziell und zeitlich unterstützte Fortbildungen, eine intensive Einarbeitung und eigene Terminplanung mit iPrax. Ein Lebenslauf ist für den ersten Kontakt freiwillig.</p>',
  identifier: {
    '@type': 'PropertyValue',
    name: 'Praxis für Logopädie Şimşek',
    value: 'LOGO-JOB-DUI-2026-01',
  },
  datePosted: '2026-09-27',
  employmentType: ['FULL_TIME', 'PART_TIME'],
  directApply: true,
  hiringOrganization: {
    '@type': 'Organization',
    name: 'Praxis für Logopädie Şimşek',
    sameAs: 'https://logopaedie-simsek.de/',
    logo: 'https://xn--logopdiejobs-kcb.de/praxis-simsek-logo.svg',
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Tonhallenstraße 21',
      addressLocality: 'Duisburg',
      addressRegion: 'Nordrhein-Westfalen',
      postalCode: '47051',
      addressCountry: 'DE',
    },
  },
  baseSalary: {
    '@type': 'MonetaryAmount',
    currency: 'EUR',
    value: {
      '@type': 'QuantitativeValue',
      minValue: 23,
      maxValue: 26,
      unitText: 'HOUR',
    },
  },
  jobBenefits:
    'Vier-Tage-Woche möglich, 30 Urlaubstage bei fünf Arbeitstagen, jährliches Weihnachtsgeld, finanziell und zeitlich unterstützte Fortbildungen, intensive Einarbeitung, eigene Terminplanung mit iPrax',
  responsibilities:
    'Diagnostik und Therapie bei Kindern, Jugendlichen und Erwachsenen sowie Dokumentation, Elternberatung, Fallbesprechungen und fachlicher Austausch.',
  qualifications:
    'Staatlich anerkannte und zugelassene Ausbildung oder Studium in Logopädie beziehungsweise Sprachtherapie sowie sehr gute Deutschkenntnisse.',
  experienceRequirements: 'no requirements',
  workHours: '38,5 Stunden Vollzeit, Teilzeit mit variablem Umfang oder Vier-Tage-Woche',
  industry: 'Gesundheitswesen',
  occupationalCategory: '84414',
  url: canonicalURL,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([name, text]) => ({
    '@type': 'Question',
    name,
    acceptedAnswer: {
      '@type': 'Answer',
      text,
    },
  })),
};
