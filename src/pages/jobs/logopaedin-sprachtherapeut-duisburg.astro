---
import PracticeBrand from '../../components/PracticeBrand.astro';
import { Image } from 'astro:assets';
import StickyContactBar from '../../components/StickyContactBar.astro';
import Fachportal from '../../layouts/Fachportal.astro';
import ApplicationContact from '../../components/ApplicationContact.astro';
import WorkplaceFilm from '../../components/WorkplaceFilm.astro';
import mara from '../../assets/team/team-mara-niessalla-grid.jpg';
import seyma from '../../assets/team/team-seyma-bozoglan-grid.jpg';
import kristina from '../../assets/team/team-kristina-imping-grid.jpg';
import emel from '../../assets/team/team-emel-simsek-ucar-grid.jpg';
import jobSource from '../../content/jobs/logopaedin-sprachtherapeut-duisburg.json' with { type: 'json' };
import { jobSchema } from '../../lib/job-model.mjs';
import { publicationArtifacts } from '../../lib/job-publication-artifacts.mjs';
import '../../styles/recruiting-landing.css';

const job = jobSchema.parse(jobSource);
const { robots, jobPosting, faqPage, showApplication, presentation } = publicationArtifacts(job);
const { canonicalUrl: canonicalURL, pageTitle, pageDescription } = presentation;

const portraits = [{ name: 'Mara', photo: mara }, { name: 'Şeyma', photo: seyma }, { name: 'Kristina', photo: kristina }, { name: 'Emel', photo: emel }];

const relatedLinks = [
  {
    href: '/berufshandbuch/logopaedin-duisburg-gesucht/',
    label: 'Logopädin in Duisburg gesucht',
  },
  {
    href: '/berufshandbuch/arbeiten-duisburg/',
    label: 'Arbeiten in Duisburg',
  },
  {
    href: '/berufshandbuch/gehalt-logopaedie-nrw/',
    label: 'Gehalt in der Logopädie NRW',
  },
  {
    href: '/berufshandbuch/4-tage-woche-logopaedie/',
    label: '4-Tage-Woche in der Logopädie',
  },
  {
    href: '/berufshandbuch/logopaedie-bewerbung-ohne-anschreiben/',
    label: 'Bewerbung ohne Anschreiben',
  },
];

---

<Fachportal trail={[
  { name: 'Startseite', href: '/' },
  { name: 'Unsere Praxis', href: '/praxis/' },
  { name: 'Stelle in Duisburg', href: Astro.url.pathname }
]} title={pageTitle} description={pageDescription} canonicalUrl={canonicalURL} robots={robots}>
  <Fragment slot="head">
    {jobPosting && <script type="application/ld+json" is:inline set:html={JSON.stringify(jobPosting)} />}
    {faqPage && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPage)} />}
  </Fragment>
  {showApplication && presentation.active ? (<>
  <article class="portal-inhalt stellenprofil" aria-labelledby="job-title">
    <section id="preview-hero" class="job-lead" aria-labelledby="job-title">
      <div class="job-heading">
        <a class="job-byline" href="/praxis/"><PracticeBrand /><span aria-hidden="true">→</span></a>
        <h1 id="job-title">Du bist <strong>Logopäd:in?</strong>
          <span>Oder Sprachtherapeut:in (m/w/d)</span>
          <small>Arbeitsort: Duisburg-Mitte</small>
        </h1>
        <p class="job-deck">Bei uns planst du deine Termine selbst. Für Befunde, Berichte und den Austausch im Team ist Zeit eingeplant.</p>
      </div>
      <div class="job-portrait" id="hero-picture">
        <div class="job-faces" id="preview-team-grid">
          {portraits.map(person => (
            <figure>
              <Image src={person.photo} alt="" widths={[128, 240, 400]} sizes="(min-width: 961px) 19vw, 24vw" loading="eager" class="job-original" />
              <figcaption>{person.name}</figcaption>
            </figure>
          ))}
        </div>
        <div id="hero-film"><WorkplaceFilm /></div>
      </div>
      <div class="job-offer" id="hero-vorteile">
        <p class="job-pay"><strong>{presentation.active.monthlySalaryLabel}</strong> brutto/Monat im Jahresmittel · je nach Erfahrung</p>
        <p class="job-pay-note">Grundlage: {presentation.active.hourlySalaryLabel} brutto pro Stunde bei {presentation.active.fullTimeHoursLabel} Wochenstunden.</p>
        <p class="job-pay-bonus"><span aria-hidden="true">+</span> <strong>Jährliches Weihnachtsgeld</strong></p>
        <a href="#kontaktformular" class="job-action">Unverbindlich kennenlernen</a>
      </div>
    </section>

    <nav id="stellenabschnitte" class="job-index" aria-label="Abschnitte der Stellenanzeige">
      <a href="#praxisalltag">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="3" y="7" width="18" height="14" rx="2" />
          <path d="M8.5 7V5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v2M3 12a23 23 0 0 0 18 0M12 12.5v3" />
        </svg>
        Arbeitsbedingungen
      </a>
      <a href="#team">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="9" cy="8" r="3" /><path d="M2.5 20v-1.5a6.5 6.5 0 0 1 13 0V20M16 5.3a3 3 0 0 1 0 5.5M17.5 13a6 6 0 0 1 4 5.6V20" />
        </svg>
        Dein Team
      </a>
      <a href="#qualifikation">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m2 9 10-5 10 5-10 5-10-5Zm4 2v5q6 5 12 0v-5m4-2v7" />
        </svg>
        Qualifikation
      </a>
      <a href="#faq">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6 3.5h12a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-7l-6 3v-3.2a3 3 0 0 1-2-2.8v-9a3 3 0 0 1 3-3Zm3.5 5a2.6 2.6 0 0 1 5 .7c0 1.8-2.5 1.9-2.5 3.5" />
          <circle cx="12" cy="15.2" r=".85" fill="currentColor" stroke="none" />
        </svg>
        Häufige Fragen
      </a>
    </nav>

    <section id="praxisalltag" class="job-section" aria-labelledby="everyday-title">
      <h2 id="everyday-title">So passt die Arbeit zu deinem Alltag.</h2>
      <dl class="short-facts" id="stellenkonditionen">
        {presentation.conditionItems.map(({ label, text, key }) => (
          <div><dt><span>{label}</span></dt><dd>{text}{key === 'contract' && ' Einstieg nach Vereinbarung.'}</dd></div>
        ))}
        <div><dt><span>Urlaub</span></dt><dd>30 Tage bei fünf Arbeitstagen, bei weniger Arbeitstagen anteilig. Heiligabend und Silvester hast du frei.</dd></div>
        <div><dt><span>Eigenständig planen</span></dt><dd>Mit iPrax legst du Termine, Pausen und Puffer selbst fest. Wir besprechen im Team, wie viele Therapien realistisch sind.</dd></div>
      </dl>
      <details class="short-full-details"><summary>Alle Details zu Arbeitsalltag und Ausstattung</summary>
        <div class="job-prose">
          <h3>Therapie und Beratung</h3>
          <p>Du arbeitest mit Kindern, Jugendlichen und Erwachsenen, etwa bei Sprachentwicklungsstörungen, Aphasie, Dysarthrie, Dysphagie, Stottern oder Poltern. Zur Stelle gehören Diagnostik, Therapie, Elternberatung und Fallbesprechungen.</p>
          <p>Sagt jemand ab, musst du den Ausfall nicht durch doppelte Arbeit nachholen.</p>
          <h3>Zeit und Ausstattung</h3>
          <p>Wochenend- und Feiertagsarbeit sind nicht vorgesehen. Dienstreisen fallen nicht an. Deine Probezeit beträgt üblicherweise sechs Monate und kann je nach Erfahrung auf drei Monate verkürzt werden.</p>
          <p>Du bekommst Therapiematerial und ein iPad mit iPrax, das du auch privat nutzen darfst. Deine Wünsche zur Arbeitszeit berücksichtigen wir. Kurzfristige private Termine während des Arbeitstags können wir im Team ermöglichen.</p>
          <h3>Dein Arbeitsplatz in Duisburg</h3>
          <p>Die Praxis liegt in der Tonhallenstraße 21, 47051 Duisburg, zwei Minuten vom Hauptbahnhof. Je nach Verfügbarkeit gibt es einen Parkplatz oder Unterstützung bei den Parkkosten. Die Küche kannst du nutzen. Getränke und Snacks sind kostenlos.</p>
          <a href="/praxis/#galerie">Praxisräume ansehen</a>
        </div>
      </details>
    </section>

    <section id="team" class="job-section" aria-labelledby="team-heading">
      <h2 id="team-heading">Lerne Emel und unser Team kennen.</h2>
      <p class="job-team-lead" id="team-begruessung">Emel leitet die Praxis und behandelt selbst. Mit Mara, Şeyma und Kristina besprichst du, was dich in der Therapie beschäftigt. Du entscheidest im Team mit, wie wir den Praxisalltag gestalten.</p>
      <div class="job-columns job-team-topics">
        <div id="dein-einstieg">
          <h3>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="3.5" y="5" width="17" height="16" rx="2" />
              <path d="M7.5 3v4m9-4v4m-13 3h17M8 15l2.5 2.5L16 12" />
            </svg>
            Dein Einstieg
          </h3>
          <p><strong>Strukturierte Einarbeitung</strong> und schrittweiser Terminaufbau geben dir Zeit anzukommen. Bei Fragen hast du jederzeit eine Ansprechperson. Bei uns sind Berufsanfänger:innen willkommen.</p>
        </div>
        <div>
          <h3>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5 3.5h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H9l-5 3v-3.3a2 2 0 0 1-1-1.7v-6a2 2 0 0 1 2-2ZM20 8a2 2 0 0 1 1.5 2v7a2 2 0 0 1-2 2v2.5L15 19h-3.5a2 2 0 0 1-2-2" />
            </svg>
            Unser Austausch
          </h3>
          <p>Einmal pro Woche besprechen wir Fälle und Termine im Team. Dazu kommen interne Schulungen und Supervision. Unsere Weihnachtsfeier und weitere Teamaktivitäten planen wir gemeinsam.</p>
        </div>
      </div>
      <details class="short-team-details"><summary>Team und fachliche Schwerpunkte</summary>
        <dl class="job-roster">
          <div><dt>Mara Nießalla</dt><dd>Erwachsenentherapie</dd></div>
          <div><dt>Şeyma Bozoğlan</dt><dd>Bilinguale Therapie auf Deutsch und Türkisch, Kindersprache und Aphasie</dd></div>
          <div><dt>Kristina Imping</dt><dd>Tiergestützte Therapie und Fütterstörungen</dd></div>
          <div><dt>Emel Şimşek-Uçar</dt><dd>Inhaberin und Logopädin mit Schwerpunkt bilinguale Diagnostik und Therapie</dd></div>
        </dl>
      </details>
    </section>

    <section id="qualifikation" class="job-section" aria-labelledby="qualification-heading">
      <h2 id="qualification-heading">Das bringst du mit.</h2>
      <div class="job-columns">
        <p>Du hast einen staatlich anerkannten Abschluss in Logopädie oder Sprachtherapie, der dich für die Behandlung gesetzlich Versicherter qualifiziert. Für die Anstellung brauchst du keine eigene Praxiszulassung. Du hast sehr gute Deutschkenntnisse. Berufserfahrung ist keine Voraussetzung. Auch ohne Türkischkenntnisse oder Führerschein bist du willkommen.</p>
        <div>
          <p>Du hast einen anderen sprachtherapeutischen Abschluss, etwa als Atem-, Sprech- und Stimmlehrer:in oder Medizinische:r Sprachheilpädagog:in? Wir prüfen im Einzelfall, für welche Behandlungen dein Abschluss anerkannt ist.</p>
          <a href="/schulen/">Noch in Ausbildung oder Studium?</a>
        </div>
      </div>
    </section>

    <ApplicationContact />

    <section id="faq" class="job-section" aria-labelledby="job-faq-heading">
      <h2 id="job-faq-heading">Häufige Fragen zur Stelle</h2>
      {presentation.faqs.map(([question, answer]) => (
        <details class="job-faq"><summary>{question}</summary><p>{answer}</p></details>
      ))}
    </section>
    <section id="berufshandbuch-links" class="job-section" aria-labelledby="job-guides-heading">
      <h2 id="job-guides-heading">Zum Weiterlesen</h2>
      <ul class="job-guides">
        {relatedLinks.map(link => <li><a href={link.href}>{link.label}<span aria-hidden="true">↗</span></a></li>)}
      </ul>
      <a class="rueckweg" href="/praxis/">← Zur Praxisübersicht</a>
    </section>
  </article>
  <StickyContactBar />
  </>) : (
    <article class="portal-inhalt stellenprofil">
      <h1>{presentation.title}</h1>
      <p>{presentation.statusMessage}</p>
      <a class="rueckweg" href="/praxis/">← Zur Praxisübersicht</a>
    </article>
  )}
</Fachportal>
