---
import Fachportal from '../layouts/Fachportal.astro';
---

<Fachportal trail={[
  { name: 'Startseite', href: '/' },
  { name: 'Seite nicht gefunden', href: Astro.url.pathname }
]}
  robots="noindex, follow"
  title="Seite nicht gefunden | Logopädie Jobs Duisburg"
  description="Diese Seite existiert nicht. Zurück zur Startseite von Logopädie Jobs."
>
  <div class="portal-inhalt leseseite">
    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-simsek-green/10 text-simsek-green border border-simsek-green/20 mb-6">
      404
    </span>
    <h1 class="text-5xl md:text-6xl font-semibold text-slate-900 mb-6 leading-tight">
      Seite nicht gefunden
    </h1>
    <p class="text-lg text-slate-600 mb-10 max-w-md mx-auto leading-relaxed">
      Über die Startseite findest du Praxisgeschichten, Fachwissen und Werkzeuge.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-6 py-3 bg-simsek-green text-white font-bold rounded-lg shadow-md  hover:shadow-lg  hover:-translate-y-0.5  transition-all duration-200 no-underline"
    >
      Zur Startseite
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>
</Fachportal>
